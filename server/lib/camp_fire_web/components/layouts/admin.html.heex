<div class="flex h-screen">
  <nav class="w-56 bg-gray-900 text-gray-300 flex flex-col py-4">
    <div class="px-4 mb-6">
      <h1 class="text-lg font-bold text-white">Camp Fire Admin</h1>
    </div>
    <.link navigate="/admin/items" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :items, do: "bg-gray-800 text-white", else: ""}"}>Items</.link>
    <.link navigate="/admin/economy" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :economy, do: "bg-gray-800 text-white", else: ""}"}>Economy</.link>
    <.link navigate="/admin/visitors" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :visitors, do: "bg-gray-800 text-white", else: ""}"}>Visitors</.link>
    <.link navigate="/admin/quests" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :quests, do: "bg-gray-800 text-white", else: ""}"}>Quests</.link>
    <.link navigate="/admin/players" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :players, do: "bg-gray-800 text-white", else: ""}"}>Players</.link>
    <.link navigate="/admin/weather" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :weather, do: "bg-gray-800 text-white", else: ""}"}>Weather</.link>
    <.link navigate="/admin/sprites" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :sprites, do: "bg-gray-800 text-white", else: ""}"}>Sprites</.link>
    <.link navigate="/admin/translations" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :translations, do: "bg-gray-800 text-white", else: ""}"}>Translations</.link>
    <.link navigate="/admin/logs" class={"block px-4 py-2 hover:bg-gray-800 #{if @active_tab == :logs, do: "bg-gray-800 text-white", else: ""}"}>Logs</.link>
  </nav>
  <main class="flex-1 overflow-y-auto p-6">
    {@inner_content}
  </main>
</div>
