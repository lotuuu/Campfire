/* Satchel panel styles */

#satchel-panel .seed-slot {
    width: 220px;
    height: 260px;
    min-height: 260px;
    align-items: center;
    justify-content: center;
}

#satchel-panel .seed-icon {
    width: 96px;
    height: 96px;
    margin-bottom: var(--spacing-sm);
}

#satchel-panel .seed-name {
    color: var(--color-text);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
}

#satchel-panel .seed-count {
    color: var(--color-text-dim);
    font-size: var(--font-xs);
}

#probability-panel {
    margin-top: var(--spacing-md);
    padding: var(--spacing-md);
    background-color: rgba(15, 30, 40, 0.50);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
}

#selected-seed-name {
    font-size: var(--font-lg);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-sm);
}

.probability-entry {
    padding: var(--spacing-xs) var(--spacing-sm);
}

.probability-name {
    font-size: var(--font-sm);
    color: var(--color-text);
}

#plant-button {
    align-self: center;
    width: 320px;
    height: 96px;
    min-height: 96px;
    margin-top: var(--spacing-md);
    font-size: var(--font-lg);
    -unity-font-style: bold;
}
