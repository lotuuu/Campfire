/* Greenhouse panel styles */

/* --- Header --- */
#greenhouse-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

#greenhouse-pollen-rate {
    color: var(--color-text-accent);
    font-size: var(--font-md);
    -unity-font-style: bold;
}

#greenhouse-slots-text {
    color: var(--color-text-dim);
    font-size: var(--font-md);
}

/* --- Plant Slot Card --- */
#greenhouse-page .plant-slot {
    width: 280px;
    height: 380px;
    min-height: 380px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 16px;
    padding-bottom: 0;
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    overflow: hidden;
}

/* Sprite frame */
.plant-sprite-frame {
    width: 160px;
    height: 160px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-xs);
}

.plant-glow {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    opacity: 0;
    /* background-color set inline from C# */
}

.plant-sprite {
    width: 140px;
    height: 140px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Name & quality */
#greenhouse-page .plant-name {
    color: var(--color-text-bright);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 var(--spacing-xxs);
}

.plant-quality {
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-xs);
    /* color set inline from C# per tier */
}

/* Decay bar */
#greenhouse-page .plant-decay-bar-bg {
    width: 80%;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
}

#greenhouse-page .plant-decay-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background-color: rgb(80, 220, 120);
    transition-property: width;
    transition-duration: 0.3s;
}

#greenhouse-page .plant-decay-bar-fill--warning {
    background-color: rgb(255, 180, 50);
}

#greenhouse-page .plant-decay-bar-fill--critical {
    background-color: rgb(255, 70, 60);
}

#greenhouse-page .plant-decay-time {
    font-size: 20px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* Rarity bar at card bottom */
.plant-rarity-bar {
    align-self: stretch;
    height: 3px;
    border-radius: 2px;
    margin-top: var(--spacing-xs);
    /* background-color set inline from C# */
}

/* --- Selection --- */
#greenhouse-page .plant-slot--selected {
    border-color: var(--color-border-accent);
    border-width: 2px;
    background-color: var(--color-bg-slot-hover);
}

/* --- Withered State --- */
#greenhouse-page .plant-slot--withered {
    opacity: 0.55;
}

#greenhouse-page .plant-slot--withered .plant-name {
    color: rgb(140, 110, 90);
}

#greenhouse-page .plant-slot--withered .plant-quality {
    display: none;
}

#greenhouse-page .plant-slot--withered .plant-decay-bar-bg {
    display: none;
}

#greenhouse-page .plant-slot--withered .plant-decay-time {
    display: none;
}

/* --- Empty Slot --- */
.plant-slot--empty {
    opacity: 0.35;
}

.plant-slot--empty .plant-name {
    color: var(--color-dim);
}

/* --- Sell Bar --- */
#greenhouse-sell-bar {
    background-color: rgba(15, 30, 40, 0.55);
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    margin-top: var(--spacing-sm);
    flex-direction: column;
    align-items: stretch;
}

#sell-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-sm);
}

#sell-bar-sprite {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-md);
    flex-shrink: 0;
}

#sell-bar-info {
    flex-grow: 1;
    flex-shrink: 1;
}

#greenhouse-sell-name {
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--spacing-xxs);
}

#greenhouse-sell-pollen {
    color: var(--color-text-accent);
    font-size: var(--font-sm);
}

/* --- Empty Hint --- */
.greenhouse-empty-hint {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: var(--spacing-xl) var(--spacing-lg);
}
