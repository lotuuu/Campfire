/* Greenhouse panel styles - mobile-first sizing */

#greenhouse-page .plant-slot {
    width: 300px;
    height: 300px;
    min-height: 300px;
    align-items: center;
    justify-content: center;
}

#greenhouse-page .plant-swatch {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    margin-bottom: var(--spacing-sm);
}

#greenhouse-page .plant-name {
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
}

#greenhouse-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

#greenhouse-dust-rate {
    color: var(--color-text-accent);
    font-size: var(--font-md);
}

#greenhouse-slots-text {
    color: var(--color-text-dim);
    font-size: var(--font-md);
}

