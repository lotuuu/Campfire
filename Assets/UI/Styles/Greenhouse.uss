/* Greenhouse panel styles */

#greenhouse-panel .plant-slot {
    width: 200px;
    height: 180px;
    min-height: 180px;
    align-items: center;
    justify-content: center;
}

#greenhouse-panel .plant-swatch {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-bottom: var(--spacing-sm);
}

#greenhouse-panel .plant-name {
    color: var(--color-text);
    font-size: var(--font-xs);
    -unity-text-align: middle-center;
}

#greenhouse-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
}

#dust-rate {
    color: var(--color-text-accent);
    font-size: var(--font-sm);
}

#slots-text {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

#expand-button {
    align-self: center;
    width: 320px;
    margin-top: var(--spacing-md);
}
