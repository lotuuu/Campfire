/* Forecast.uss — 5-day forecast dropdown styling */

#forecast-panel {
    display: none;
    background-color: rgba(20, 14, 8, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 120, 60, 0.2);
    padding: var(--spacing-xs) var(--spacing-sm);
    flex-shrink: 0;
}

#forecast-panel.forecast-visible {
    display: flex;
}

#forecast-days {
    flex-direction: row;
    justify-content: space-around;
}

.forecast-day {
    flex-direction: column;
    align-items: center;
    width: 20%;
    padding: var(--spacing-xxs) 0;
}

.forecast-day-label {
    font-size: var(--font-xs);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-xxs);
}

.forecast-day-icon {
    font-size: var(--font-lg);
    color: rgb(255, 220, 120);
    margin-bottom: var(--spacing-xxs);
}

.forecast-day-temp {
    font-size: var(--font-xs);
    color: var(--color-text);
}
