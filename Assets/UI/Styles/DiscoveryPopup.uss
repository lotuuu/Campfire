/* ── Overlay ─────────────────────────────────────────────── */

.discovery-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.88);
    align-items: center;
    justify-content: center;
    transition: opacity 300ms ease-out;
}

/* ── Card ────────────────────────────────────────────────── */

.discovery-card {
    width: 500px;
    max-width: 88%;
    background-color: var(--color-bg-popup);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
    padding: 40px 32px 32px 32px;
    align-items: center;
    overflow: hidden;
    transition: opacity 450ms ease-out, scale 450ms ease-out;
}

/* ── Card Radiance (large diffuse glow behind content) ──── */

.card-radiance {
    position: absolute;
    width: 600px;
    height: 600px;
    top: -150px;
    border-radius: 50%;
    opacity: 0.06;
    /* background-color set inline from variant.primaryColor */
}

/* ── Header Banner ──────────────────────────────────────── */

.discovery-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    justify-content: center;
    margin-bottom: var(--spacing-lg);
    transition: opacity 350ms ease-out;
}

.header-rule {
    flex-grow: 1;
    height: 1px;
    background-color: var(--color-border-accent);
    opacity: 0.4;
}

.header-label {
    font-size: 22px;
    letter-spacing: 6px;
    color: var(--color-text-accent);
    -unity-text-align: middle-center;
    padding: 0 20px;
    -unity-font-style: bold;
}

/* ── Sprite Stage ───────────────────────────────────────── */

.sprite-stage {
    width: 280px;
    height: 280px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
    transition: opacity 500ms ease-out, scale 500ms ease-out;
}

.sprite-glow {
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    opacity: 0.12;
    /* background-color set inline from variant.primaryColor */
}

.sprite-ring {
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(140, 230, 240, 0.15);
}

.discovery-sprite {
    width: 220px;
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Name ────────────────────────────────────────────────── */

.discovery-name {
    font-size: var(--font-xl);
    -unity-font-style: bold;
    color: var(--color-text-bright);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--spacing-xs);
    transition: opacity 400ms ease-out;
}

/* ── Rarity Badge ───────────────────────────────────────── */

.rarity-badge {
    border-radius: 20px;
    padding: 6px 24px;
    margin-bottom: var(--spacing-md);
    border-width: 1px;
    transition: opacity 400ms ease-out;
}

.rarity-badge-text {
    font-size: 20px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Rarity badge variants */
.badge-common {
    background-color: rgba(160, 175, 185, 0.10);
    border-color: rgba(160, 175, 185, 0.25);
}
.badge-common > .rarity-badge-text { color: var(--color-rarity-common); }

.badge-uncommon {
    background-color: rgba(80, 200, 120, 0.10);
    border-color: rgba(80, 200, 120, 0.25);
}
.badge-uncommon > .rarity-badge-text { color: var(--color-rarity-uncommon); }

.badge-rare {
    background-color: rgba(80, 160, 255, 0.10);
    border-color: rgba(80, 160, 255, 0.25);
}
.badge-rare > .rarity-badge-text { color: var(--color-rarity-rare); }

.badge-epic {
    background-color: rgba(190, 80, 255, 0.10);
    border-color: rgba(190, 80, 255, 0.25);
}
.badge-epic > .rarity-badge-text { color: var(--color-rarity-epic); }

.badge-legendary {
    background-color: rgba(255, 185, 50, 0.10);
    border-color: rgba(255, 185, 50, 0.25);
}
.badge-legendary > .rarity-badge-text { color: var(--color-rarity-legendary); }

/* ── Ornamental Divider ─────────────────────────────────── */

.ornament-divider {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-bottom: var(--spacing-md);
    padding: 0 var(--spacing-lg);
    transition: opacity 400ms ease-out;
}

.ornament-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--color-border);
}

.ornament-diamond {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-width: 1px;
    border-color: var(--color-border-accent);
    margin-left: 12px;
    margin-right: 12px;
}

/* ── Description ─────────────────────────────────────────── */

.discovery-description {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--spacing-lg);
    padding: 0 var(--spacing-sm);
    transition: opacity 400ms ease-out;
}

/* ── Actions ─────────────────────────────────────────────── */

.discovery-actions {
    align-self: stretch;
    align-items: center;
    transition: opacity 400ms ease-out;
}

.discovery-share-btn {
    align-self: stretch;
    height: 72px;
    border-radius: var(--radius-md);
    background-color: rgba(20, 40, 55, 0.65);
    border-color: var(--color-border-accent);
    border-width: 1px;
    color: var(--color-text-accent);
    font-size: var(--font-sm);
    letter-spacing: 1px;
    margin-bottom: var(--spacing-sm);
    transition: background-color 200ms ease-out, border-color 200ms ease-out;
}

.discovery-share-btn:hover {
    background-color: rgba(30, 60, 80, 0.75);
    border-color: rgba(140, 230, 240, 0.55);
}

.discovery-dismiss-hint {
    font-size: var(--font-xs);
    color: var(--color-dim);
    -unity-text-align: middle-center;
}
