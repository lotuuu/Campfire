/* ── Overlay ─────────────────────────────────────────────── */

.discovery-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

/* ── Card ────────────────────────────────────────────────── */

.discovery-card {
    width: 460px;
    max-width: 88%;
    background-color: var(--color-bg-popup);
    border-width: 2px;
    border-color: var(--color-border-accent);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl) var(--spacing-lg);
    align-items: center;
    overflow: hidden;
}

/* ── Glow ────────────────────────────────────────────────── */

.discovery-glow {
    position: absolute;
    left: -40px; right: -40px;
    top: -40px; bottom: -40px;
    border-radius: 50%;
    opacity: 0.15;
    /* background-color set inline from C# using variant.primaryColor */
}

/* ── Sprite ──────────────────────────────────────────────── */

.discovery-sprite {
    width: 200px;
    height: 200px;
    margin-bottom: var(--spacing-md);
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Name ────────────────────────────────────────────────── */

.discovery-name {
    font-size: var(--font-lg);
    -unity-font-style: bold;
    color: var(--color-text-bright);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--spacing-xxs);
}

/* ── Rarity ──────────────────────────────────────────────── */

.discovery-rarity {
    font-size: var(--font-xs);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-md);
}

/* Rarity color classes */
.rarity-common    { color: var(--color-rarity-common); }
.rarity-uncommon  { color: var(--color-rarity-uncommon); }
.rarity-rare      { color: var(--color-rarity-rare); }
.rarity-epic      { color: var(--color-rarity-epic); }
.rarity-legendary { color: var(--color-rarity-legendary); }

/* ── Divider ─────────────────────────────────────────────── */

.discovery-divider {
    height: 1px;
    align-self: stretch;
    background-color: var(--color-border);
    margin-bottom: var(--spacing-md);
}

/* ── Description ─────────────────────────────────────────── */

.discovery-description {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--spacing-lg);
}

/* ── Actions ─────────────────────────────────────────────── */

.discovery-actions {
    align-self: stretch;
    align-items: center;
}

.discovery-share-btn {
    align-self: stretch;
    height: 72px;
    border-radius: var(--radius-md);
    background-color: var(--color-button-bg);
    border-color: var(--color-border-accent);
    border-width: 1px;
    color: var(--color-text-accent);
    font-size: var(--font-sm);
    margin-bottom: var(--spacing-sm);
}

.discovery-share-btn:hover {
    background-color: var(--color-button-bg-hover);
}

.discovery-dismiss-hint {
    font-size: var(--font-xs);
    color: var(--color-dim);
    -unity-text-align: middle-center;
}
