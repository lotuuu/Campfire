/* CampsiteGrid.uss — Grid cell styles for campsite hex grid */

/* ── Grid cell base ── */
/* Hex shape drawn via Painter2D; --hex-fill/--hex-border drive the colors */
.grid-cell {
    width: 380px;
    height: 380px;
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: var(--spacing-xxs);
    --hex-fill: rgba(30, 55, 20, 0.3);
    --hex-border: rgba(70, 120, 45, 0.15);
}

/* ── Empty cell ── */
.grid-cell--empty {
    --hex-fill: rgb(123, 135, 60);
    --hex-border: rgba(123, 135, 60, 0.4);
}

/* ── Placement mode highlights ── */
.grid-cell--placeable {
    --hex-fill: rgba(120, 180, 60, 0.15);
    --hex-border: rgba(120, 180, 60, 0.4);
}

.grid-cell--placeable:hover {
    --hex-fill: rgba(120, 180, 60, 0.3);
    --hex-border: rgba(160, 220, 80, 0.6);
}

/* ── Watering mode highlights ── */
.grid-cell--water-target {
    --hex-fill: rgba(60, 140, 220, 0.2);
    --hex-border: rgba(80, 160, 240, 0.5);
}

.grid-cell--water-target:hover {
    --hex-fill: rgba(60, 140, 220, 0.35);
    --hex-border: rgba(100, 180, 255, 0.7);
}

.grid-cell--water-cooldown {
    --hex-fill: rgba(80, 80, 80, 0.15);
    --hex-border: rgba(120, 120, 120, 0.4);
}

.cell-progress-fill--cooldown {
    background-color: rgba(80, 160, 240, 0.6);
}

/* ── Flame cell ── */
.grid-cell--flame {
    --hex-fill: rgba(220, 100, 20, 0.3);
    --hex-border: rgba(255, 180, 60, 0.5);
}

.grid-cell--flame:hover {
    --hex-fill: rgba(240, 120, 30, 0.4);
    --hex-border: rgba(255, 200, 80, 0.7);
}

.grid-cell--flame .cell-icon {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgb(220, 100, 20);
    border-width: 3px;
    border-color: rgba(255, 180, 60, 0.6);
}

/* ── Plot cell ── */
.grid-cell--plot {
    --hex-fill: rgba(60, 160, 40, 0.5);
    --hex-border: rgba(80, 200, 50, 0.4);
}

.grid-cell--plot:hover {
    --hex-fill: rgba(70, 180, 50, 0.6);
    --hex-border: rgba(100, 220, 70, 0.6);
}

.grid-cell--plot .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    background-color: rgba(60, 160, 40, 0.4);
}

.grid-cell--plot-mature {
    --hex-border: rgba(100, 220, 70, 0.6);
}

/* ── Vase cell ── */
.grid-cell--vase {
    --hex-fill: rgba(50, 100, 180, 0.5);
    --hex-border: rgba(70, 130, 210, 0.4);
}

.grid-cell--vase:hover {
    --hex-fill: rgba(60, 120, 200, 0.6);
    --hex-border: rgba(90, 150, 230, 0.6);
}

.grid-cell--vase .cell-icon {
    width: 48px;
    height: 56px;
    border-radius: 8px;
    background-color: rgba(50, 100, 180, 0.4);
}

/* ── Garden cell ── */
.grid-cell--garden {
    --hex-fill: rgba(25, 50, 20, 0.6);
    --hex-border: rgba(60, 120, 40, 0.3);
}

.grid-cell--garden:hover {
    --hex-fill: rgba(30, 58, 24, 0.7);
    --hex-border: rgba(100, 200, 60, 0.5);
}

.grid-cell--garden .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(60, 120, 40, 0.4);
}

/* ── Mallum House cell ── */
.grid-cell--mallum-house {
    --hex-fill: rgba(139, 90, 43, 0.6);
    --hex-border: rgba(180, 130, 70, 0.3);
}

.grid-cell--mallum-house:hover {
    --hex-fill: rgba(155, 100, 50, 0.7);
    --hex-border: rgba(200, 150, 90, 0.5);
}

.grid-cell--mallum-house .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background-color: rgba(139, 90, 43, 0.4);
}

/* ── Apotheke cell ── */
.grid-cell--apotheke {
    --hex-fill: rgba(100, 50, 140, 0.4);
    --hex-border: rgba(160, 100, 200, 0.45);
}

.grid-cell--apotheke:hover {
    --hex-fill: rgba(120, 60, 160, 0.55);
    --hex-border: rgba(180, 120, 220, 0.65);
}

.grid-cell--apotheke .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background-color: rgba(120, 60, 160, 0.4);
}

/* ── Bird cell ── */
.grid-cell--bird {
    --hex-fill: rgba(180, 220, 255, 0.4);
    --hex-border: rgba(100, 160, 220, 0.45);
}

.grid-cell--bird:hover {
    --hex-fill: rgba(190, 230, 255, 0.55);
    --hex-border: rgba(120, 180, 240, 0.65);
}

.grid-cell--bird .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background-color: rgba(100, 160, 220, 0.4);
}

/* ── Merchant cell ── */
.grid-cell--visitor {
    --hex-fill: rgba(180, 140, 60, 0.45);
    --hex-border: rgba(220, 180, 80, 0.5);
}

.grid-cell--visitor:hover {
    --hex-fill: rgba(200, 160, 70, 0.6);
    --hex-border: rgba(240, 200, 100, 0.7);
}

.grid-cell--visitor .cell-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background-color: rgba(180, 140, 60, 0.4);
}

/* ── Cell inner elements ── */
.cell-icon {
    margin-bottom: var(--spacing-xxs);
}

.grid-cell--sprite {
    -unity-background-scale-mode: scale-to-fit;
}

.grid-cell--sprite .cell-icon {
    display: none;
}

.grid-cell--sprite .cell-label {
    display: none;
}

.grid-cell--sprite .cell-status {
    display: none;
}

.cell-label {
    font-size: 22px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.cell-status {
    font-size: 18px;
    color: var(--color-text-dim);
    -unity-text-align: upper-center;
}

/* ── Progress bar ── */
.cell-progress {
    width: 80%;
    height: 6px;
    background-color: rgba(20, 35, 15, 0.6);
    border-radius: 3px;
    overflow: hidden;
    margin-top: var(--spacing-xxs);
    display: none;
}

.cell-progress--visible {
    display: flex;
}

.cell-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(120, 180, 60);
    border-radius: 3px;
}

/* ── Drag-move highlights ── */
.grid-cell--drag-origin {
    opacity: 0.3;
}

.grid-cell--drop-target {
    --hex-fill: rgba(120, 180, 60, 0.1);
    --hex-border: rgba(120, 180, 60, 0.3);
}

.grid-cell--drop-hover {
    --hex-fill: rgba(120, 180, 60, 0.35);
    --hex-border: rgba(160, 220, 80, 0.7);
}

/* ── Watering mode dim for non-waterable cells ── */
.grid-cell--dimmed {
    opacity: 0.35;
}

/* ── Placement cancel button ── */
#placement-cancel {
    position: absolute;
    bottom: var(--spacing-lg);
    left: 50%;
    translate: -50% 0;
    padding: var(--spacing-sm) var(--spacing-xl);
    background-color: rgba(140, 40, 30, 0.8);
    border-width: 2px;
    border-color: rgba(200, 80, 60, 0.5);
    border-radius: var(--radius-md);
    color: rgb(255, 220, 200);
    font-size: var(--font-md);
}

#placement-cancel:hover {
    background-color: rgba(160, 50, 35, 0.9);
}

/* ── Visit back button ── */
#visit-back-btn {
    position: absolute;
    top: var(--spacing-lg);
    left: var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-xl);
    font-size: var(--font-lg);
    border-radius: var(--radius-md);
}

#visit-back-btn:hover {
    background-color: rgba(180, 115, 35, 0.85);
}

/* ── Skin Selector ── */

/* Panel override: pin to top instead of center */
.skin-panel {
    top: 5%;
    translate: 0 0;
}

/* Header row with back arrow + title */
.skin-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-bottom: var(--spacing-sm);
}

.skin-back-arrow {
    width: 64px;
    height: 64px;
    min-width: 64px;
    font-size: var(--font-lg);
    -unity-text-align: middle-center;
    background-color: rgba(80, 55, 25, 0.4);
    border-radius: 32px;
    border-width: 1px;
    border-color: rgba(180, 130, 50, 0.25);
    color: rgb(220, 180, 100);
    padding: 0;
    margin-right: var(--spacing-sm);
}

.skin-back-arrow:hover {
    background-color: rgba(120, 80, 30, 0.6);
    border-color: rgba(220, 160, 60, 0.5);
}

.skin-title {
    font-size: var(--font-xxl);
    color: rgb(245, 215, 130);
    -unity-font-style: bold;
}

/* ── Skin Carousel ── */

.skin-carousel-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md) 0;
    margin-bottom: var(--spacing-sm);
}

/* Ghost neighbor swatches — tappable navigation targets */
.skin-carousel-ghost {
    width: 140px;
    min-width: 140px;
    align-items: center;
    justify-content: center;
    opacity: 0.3;
}

.skin-carousel-ghost--left {
    margin-right: var(--spacing-lg);
}

.skin-carousel-ghost--right {
    margin-left: var(--spacing-lg);
}

/* Center swatch container */
.skin-carousel-center {
    align-items: center;
    justify-content: center;
}

/* Base swatch tile */
.skin-swatch {
    padding: var(--spacing-sm);
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: rgba(140, 100, 50, 0.15);
    align-items: center;
    justify-content: center;
    background-color: rgba(40, 25, 12, 0.35);
}

/* Center (active) swatch — big hero for mobile */
.skin-swatch--center {
    width: 280px;
    min-width: 280px;
    height: 280px;
    border-width: 4px;
    border-color: rgba(220, 165, 55, 0.6);
    border-radius: var(--radius-lg);
    background-color: rgba(55, 35, 15, 0.65);
}

/* Ghost (neighbor peek) swatch */
.skin-swatch--ghost {
    width: 130px;
    min-width: 130px;
    height: 130px;
    border-width: 2px;
    border-color: rgba(140, 100, 50, 0.12);
    border-radius: var(--radius-md);
    background-color: rgba(40, 25, 12, 0.2);
}

/* Equipped skin ring glow */
.skin-swatch--equipped {
    border-color: rgba(120, 190, 60, 0.55);
}

/* Color preview inside swatch */
.skin-swatch-preview {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    border-width: 2px;
}

.skin-swatch--center .skin-swatch-preview {
    width: 220px;
    height: 220px;
    border-radius: 28px;
    border-width: 5px;
}

.skin-swatch--ghost .skin-swatch-preview {
    width: 90px;
    height: 90px;
    border-radius: 16px;
    border-width: 2px;
}

/* Lock overlay on locked swatches */
.skin-swatch-lock {
    position: absolute;
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(200, 180, 140, 0.7);
}

.skin-swatch--center .skin-swatch-lock {
    width: 96px;
    height: 96px;
}

.skin-swatch--ghost .skin-swatch-lock {
    width: 48px;
    height: 48px;
    -unity-background-image-tint-color: rgba(200, 180, 140, 0.5);
}

/* Skin name above carousel */
.skin-carousel-name {
    font-size: var(--font-lg);
    color: rgb(210, 180, 120);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

/* Pip dots row */
.skin-carousel-pips {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

.skin-carousel-pip {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgba(140, 100, 50, 0.2);
    margin: 0 6px;
}

.skin-carousel-pip--active {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(230, 175, 60, 0.85);
    margin: 0 5px;
}

.skin-carousel-pip--equipped {
    background-color: rgba(120, 190, 60, 0.45);
}

/* Thin separator line */
.skin-carousel-separator {
    height: 1px;
    align-self: stretch;
    margin: 0 var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    background-color: rgba(180, 130, 50, 0.18);
}

/* ── Skin Detail ── */

.skin-detail {
    padding: 0 var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    align-items: center;
}

.skin-detail-equipped {
    font-size: var(--font-lg);
    color: rgba(120, 190, 60, 0.9);
    -unity-font-style: italic;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-sm);
}

/* Big action button (Paint / Unlock) */
.skin-action-btn {
    align-self: stretch;
    min-height: 100px;
    background-color: rgba(160, 100, 30, 0.6);
    border-width: 2px;
    border-color: rgba(220, 160, 50, 0.5);
    border-radius: var(--radius-md);
    color: rgb(255, 220, 150);
    font-size: var(--font-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: var(--spacing-xs);
}

.skin-action-btn:hover {
    background-color: rgba(180, 115, 35, 0.75);
    border-color: rgba(240, 180, 60, 0.7);
}

.skin-action-btn:disabled {
    background-color: rgba(40, 30, 18, 0.4);
    border-color: rgba(100, 70, 35, 0.2);
    color: rgb(120, 100, 75);
}

/* Cost row with pigment icon + count */
.skin-cost-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
}

.skin-cost-icon {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-sm);
}

.skin-cost-text {
    font-size: var(--font-xl);
    -unity-font-style: bold;
}

.skin-cost-text--have {
    color: rgb(120, 200, 80);
}

.skin-cost-text--need {
    color: rgb(220, 100, 70);
}
