/* Tutorial hint bar */
#tutorial-hint-bar {
    position: absolute;
    bottom: 90px;
    left: 20px;
    right: 20px;
    padding: 12px 20px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

#tutorial-hint-text {
    color: rgb(255, 230, 170);
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

/* Highlight for tutorial targets — golden hex tint, pulsed via C# class toggle */
.tutorial-highlight {
    --hex-fill: rgba(255, 200, 60, 0.25);
    --hex-border: rgba(255, 200, 60, 0.7);
    -unity-background-image-tint-color: rgba(255, 230, 170, 1);
    transition-property: --hex-fill, --hex-border, -unity-background-image-tint-color;
    transition-duration: 0.4s;
}

.tutorial-highlight-dim {
    --hex-fill: rgba(255, 200, 60, 0.1);
    --hex-border: rgba(255, 200, 60, 0.3);
    -unity-background-image-tint-color: rgba(240, 220, 190, 1);
    transition-property: --hex-fill, --hex-border, -unity-background-image-tint-color;
    transition-duration: 0.4s;
}
