/* Tutorial hint box — flow element that replaces bottom-nav */
#tutorial-hint-box {
    background-color: var(--color-bg-panel);
    border-top-width: 3px;
    border-top-color: var(--color-border-accent);
    padding: var(--spacing-md);
    height: var(--bottom-bar-height);
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

#tutorial-hint-speaker {
    font-size: var(--font-lg);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xxs);
}

#tutorial-hint-text {
    font-size: var(--font-md);
    color: var(--color-text);
    white-space: normal;
}

/* Tutorial centered hint — floating in middle of screen */
#tutorial-hint-centered {
    position: absolute;
    left: var(--spacing-lg);
    right: var(--spacing-lg);
    top: 50%;
    translate: 0 -50%;
    background-color: var(--color-bg-panel);
    border-width: 3px;
    border-color: var(--color-border-accent);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    justify-content: center;
    align-items: center;
}

#tutorial-hint-centered-speaker {
    font-size: var(--font-lg);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xxs);
}

#tutorial-hint-centered-text {
    font-size: var(--font-md);
    color: var(--color-text);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Tutorial target hex — golden tint like watering targets but warm */
.grid-cell--tutorial-target {
    --hex-fill: rgba(255, 200, 60, 0.2);
    --hex-border: rgba(255, 200, 60, 0.6);
    -unity-background-image-tint-color: rgba(255, 235, 190, 1);
}

/* Highlight for non-hex UI elements (buttons etc) — pulsed via C# class toggle */
.tutorial-highlight {
    border-color: rgba(255, 200, 60, 0.9);
    border-width: 3px;
    transition-property: border-color, border-width;
    transition-duration: 0.4s;
}

.tutorial-highlight-dim {
    border-color: rgba(255, 200, 60, 0.3);
    border-width: 2px;
    transition-property: border-color, border-width;
    transition-duration: 0.4s;
}
