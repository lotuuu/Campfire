/* Tutorial hint bar — identical to #dialogue-overlay, minus the portrait */
#tutorial-hint-bar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: flex-end;
}

/* Centered variant — hint box in middle of screen */
#tutorial-hint-bar.tutorial-hint--centered {
    justify-content: center;
}

#tutorial-hint-box {
    background-color: rgba(20, 14, 8, 0.95);
    border-top-width: 2px;
    border-color: rgba(220, 180, 80, 0.5);
    padding: var(--spacing-lg) var(--spacing-lg);
    padding-bottom: var(--spacing-xl);
    min-height: 500px;
}

#tutorial-hint-speaker {
    font-size: var(--font-lg);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xs);
}

#tutorial-hint-text {
    font-size: var(--font-md);
    color: var(--color-text);
    white-space: normal;
    margin-bottom: var(--spacing-md);
}

/* Tutorial target hex — golden tint like watering targets but warm */
.grid-cell--tutorial-target {
    --hex-fill: rgba(255, 200, 60, 0.2);
    --hex-border: rgba(255, 200, 60, 0.6);
    -unity-background-image-tint-color: rgba(255, 235, 190, 1);
}

/* Highlight for non-hex UI elements (buttons etc) — pulsed via C# class toggle */
.tutorial-highlight {
    border-color: rgba(255, 200, 60, 0.9);
    border-width: 3px;
    transition-property: border-color, border-width;
    transition-duration: 0.4s;
}

.tutorial-highlight-dim {
    border-color: rgba(255, 200, 60, 0.3);
    border-width: 2px;
    transition-property: border-color, border-width;
    transition-duration: 0.4s;
}
