/* Build.uss — Build overlay styling */

#build-panel {
    flex-direction: column;
}

#build-list {
    flex-direction: row;
    flex-wrap: wrap;
    padding: var(--spacing-xs);
    justify-content: center;
}

/* ── Build card ── */
.build-card {
    flex-direction: column;
    align-items: center;
    width: 48%;
    background-color: rgba(50, 38, 22, 0.8);
    border-width: 2px;
    border-color: rgba(180, 130, 60, 0.4);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin: 1%;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.build-card:hover {
    background-color: rgba(65, 48, 28, 0.85);
    border-color: rgba(220, 160, 60, 0.6);
}

.build-card:disabled {
    background-color: rgba(30, 25, 16, 0.5);
    border-color: rgba(80, 60, 30, 0.15);
    opacity: 0.45;
}

.build-card:disabled .build-card__icon {
    -unity-background-image-tint-color: rgb(120, 120, 120);
}

.build-card:disabled .build-card__name {
    color: rgb(140, 130, 110);
}

.build-card:disabled .build-card__cost-chip-label {
    color: rgb(160, 130, 80);
}

/* Shown on disabled cards to explain why */
.build-card__locked-label {
    font-size: var(--font-sm);
    color: rgb(220, 100, 80);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.build-card__icon {
    width: 120px;
    height: 120px;
    margin-bottom: var(--spacing-xs);
    -unity-background-scale-mode: scale-to-fit;
}

.build-card__name {
    font-size: var(--font-md);
    color: rgb(255, 220, 150);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.build-card__desc {
    font-size: var(--font-sm);
    color: rgb(170, 150, 120);
    -unity-text-align: middle-center;
    margin-bottom: var(--spacing-xs);
}

.build-card__costs {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.build-card__cost-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 22, 12, 0.7);
    border-radius: 16px;
    padding: 4px 10px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.build-card__cost-chip-icon {
    width: 28px;
    height: 28px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.build-card__cost-chip-label {
    font-size: var(--font-sm);
    color: rgb(255, 200, 80);
    -unity-font-style: bold;
}

.build-card__cap {
    font-size: var(--font-xs);
    color: rgb(140, 120, 90);
    -unity-text-align: middle-center;
}

/* ── Craft item card (used by Apotheke) ── */
.craft-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(50, 38, 22, 0.6);
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.25);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.craft-item:hover {
    background-color: rgba(65, 48, 28, 0.7);
    border-color: rgba(180, 120, 60, 0.4);
}

.craft-name {
    font-size: var(--font-md);
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    flex-grow: 1;
}

.craft-cost {
    font-size: var(--font-sm);
    color: rgb(255, 170, 60);
    margin-right: var(--spacing-md);
    flex-shrink: 0;
}

.craft-action {
    min-width: 120px;
    min-height: 72px;
    background-color: rgba(140, 80, 20, 0.5);
    border-width: 1px;
    border-color: rgba(200, 140, 50, 0.4);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 150);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.craft-action:hover {
    background-color: rgba(160, 95, 25, 0.65);
    border-color: rgba(220, 160, 60, 0.6);
}

.craft-action:disabled {
    background-color: rgba(40, 30, 18, 0.4);
    border-color: rgba(100, 70, 35, 0.2);
    color: rgb(120, 100, 75);
}
