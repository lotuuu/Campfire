/* Floating quest button */
#quest-float-btn {
    position: absolute;
    bottom: 200px;
    left: 24px;
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--color-text-accent);
    background-image: none;
    align-items: center;
    justify-content: center;
    -unity-font-style: bold;
    font-size: var(--font-md);
    color: var(--color-text-bright);
    border-width: 0;
    transition-property: scale;
    transition-duration: 150ms;
}

#quest-float-btn:hover {
    scale: 1.08;
}

#quest-float-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text-bright);
}

#quest-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #e74c3c;
    color: white;
    font-size: var(--font-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
    display: none;
}

/* Quest panel */
#quests-panel {
    flex-direction: column;
    flex-grow: 1;
}

.quest-section-title {
    font-size: var(--font-sm);
    -unity-font-style: bold;
    color: var(--color-text-dim);
    margin-bottom: 12px;
    margin-top: 24px;
    padding-left: 8px;
}

.quest-section-title-first {
    margin-top: 0;
}

/* Quest card */
.quest-card {
    flex-direction: column;
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 12px;
    border-width: 2px;
    border-color: var(--color-border);
    transition-property: scale;
    transition-duration: 100ms;
}

.quest-card:hover {
    scale: 1.01;
}

.quest-card--active {
    border-color: var(--color-text-accent);
}

.quest-card--complete {
    border-color: #27ae60;
}

.quest-card--locked {
    opacity: 0.5;
}

.quest-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.quest-card-name {
    font-size: var(--font-md);
    -unity-font-style: bold;
    color: var(--color-text);
    flex-shrink: 1;
}

.quest-card-duration {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    flex-shrink: 0;
    margin-left: 12px;
}

.quest-card-description {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    margin-bottom: 12px;
    white-space: normal;
}

.quest-card-rewards {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.quest-reward-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg-dark);
    border-radius: 12px;
    padding: 4px 12px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.quest-reward-name {
    font-size: var(--font-xs);
    color: var(--color-text);
}

.quest-card-progress {
    height: 8px;
    background-color: var(--color-bg-dark);
    border-radius: 4px;
    margin-bottom: 12px;
}

.quest-card-progress-fill {
    height: 100%;
    background-color: var(--color-text-accent);
    border-radius: 4px;
}

.quest-card-timer {
    font-size: var(--font-sm);
    color: var(--color-text-accent);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.quest-card-action {
    align-self: stretch;
    height: 64px;
    border-radius: var(--radius-sm);
    background-color: var(--color-text-accent);
    color: var(--color-text-bright);
    font-size: var(--font-sm);
    -unity-font-style: bold;
    border-width: 0;
}

.quest-card-action:hover {
    opacity: 0.9;
}

.quest-card-action:disabled {
    opacity: 0.4;
}

.quest-collect-btn {
    background-color: #27ae60;
}

.quest-locked-label {
    font-size: var(--font-xs);
    color: var(--color-text-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.quest-mallum-status {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    padding: 12px;
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-sm);
}

.quest-empty-text {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    padding: 24px;
}
