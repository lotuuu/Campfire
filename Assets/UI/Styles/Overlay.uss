/* Overlay.uss — Shared overlay / slide-up panel styling */

#overlay-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

#overlay-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

#overlay-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 70%;
    background-color: rgba(30, 20, 12, 0.96);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    border-top-width: 1px;
    border-top-color: rgba(180, 120, 60, 0.3);
    padding: var(--spacing-md) var(--spacing-lg);
    flex-direction: column;
    transition-property: translate;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

#overlay-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
    flex-shrink: 0;
}

#overlay-title {
    font-size: var(--font-xl);
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
}

#overlay-close {
    width: 110px;
    height: 110px;
    background-color: rgba(60, 40, 20, 0.6);
    background-image: url("project://database/Assets/ThirdParty/icons/lorc-cross-mark.png");
    -unity-background-image-tint-color: rgb(180, 150, 110);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: 55px;
    padding: 20px;
}

#overlay-close:hover {
    background-color: rgba(80, 50, 25, 0.7);
    border-color: rgba(180, 120, 60, 0.5);
}

#overlay-body {
    flex-grow: 1;
}

#overlay-body > .unity-scroller--vertical {
    display: none;
}

#overlay-body > .unity-scroller--horizontal {
    display: none;
}

#overlay-body .unity-scroll-view__content-container {
    padding-bottom: var(--spacing-lg);
}

/* Hide overlay panels by default */
#apotheke-panel,
#letters-panel,
#build-panel {
    display: none;
    flex-grow: 1;
}
