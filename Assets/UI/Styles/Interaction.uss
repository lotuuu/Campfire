/* Interaction.uss — Camp object interaction popup */

#interaction-panel {
    position: absolute;
    left: var(--spacing-md);
    right: var(--spacing-md);
    bottom: 120px;
    background-color: rgba(30, 20, 12, 0.95);
    border-width: 1px;
    border-color: rgba(180, 120, 60, 0.3);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md) var(--spacing-lg);
    flex-direction: column;
    display: none;
}

#interaction-title {
    font-size: var(--font-lg);
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-sm);
}

#interaction-body {
    margin-bottom: var(--spacing-sm);
}

#interaction-body Label {
    font-size: var(--font-sm);
    color: rgb(180, 160, 130);
}

#interaction-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: var(--spacing-xs);
}

#interaction-actions Button {
    min-width: 140px;
    min-height: 72px;
    background-color: rgba(140, 80, 20, 0.5);
    border-width: 1px;
    border-color: rgba(200, 140, 50, 0.4);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 150);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
    margin-left: var(--spacing-xs);
}

#interaction-actions Button:hover {
    background-color: rgba(160, 95, 25, 0.65);
    border-color: rgba(220, 160, 60, 0.6);
}
