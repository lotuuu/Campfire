/* Interaction.uss — Camp object interaction popup */

#interaction-panel {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 50%;
    translate: 0 -50%;
    background-color: rgba(30, 20, 12, 0.95);
    border-width: 2px;
    border-color: rgba(180, 120, 60, 0.4);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    flex-direction: column;
    align-items: center;
    display: none;
}

#interaction-title {
    font-size: 36px;
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-md);
}

#interaction-body {
    margin-bottom: var(--spacing-md);
    align-items: center;
}

.interaction-info {
    font-size: 28px;
    color: rgb(180, 160, 130);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.interaction-info-highlight {
    font-size: 28px;
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

#interaction-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacing-sm);
}

#interaction-actions Button {
    min-width: 180px;
    min-height: 80px;
    background-color: rgba(100, 70, 30, 0.5);
    border-width: 1px;
    border-color: rgba(180, 120, 50, 0.3);
    border-radius: var(--radius-sm);
    color: rgb(220, 200, 160);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
}

#interaction-actions Button:hover {
    background-color: rgba(120, 85, 35, 0.65);
    border-color: rgba(200, 140, 60, 0.5);
}

/* Primary action button */
.interaction-btn-primary {
    background-color: rgba(160, 100, 30, 0.6) !important;
    border-color: rgba(220, 160, 50, 0.5) !important;
    color: rgb(255, 220, 150) !important;
}

.interaction-btn-primary:hover {
    background-color: rgba(180, 115, 35, 0.75) !important;
    border-color: rgba(240, 180, 60, 0.7) !important;
}
