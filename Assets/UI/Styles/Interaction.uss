/* Interaction.uss — Camp object interaction popup */

#interaction-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

#interaction-panel {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 50%;
    translate: 0 -50%;
    max-height: 85%;
    overflow: hidden;
    background-color: rgba(30, 20, 12, 0.95);
    border-width: 2px;
    border-color: rgba(180, 120, 60, 0.4);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md) var(--spacing-md);
    flex-direction: column;
    align-items: center;
    display: none;
}

#interaction-close {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    width: 72px;
    height: 72px;
    background-color: rgba(60, 40, 20, 0.6);
    background-image: url("project://database/Assets/ThirdParty/icons/lorc-cross-mark.png");
    -unity-background-image-tint-color: rgb(200, 120, 100);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: 36px;
    padding: 14px;
}

#interaction-close:hover {
    background-color: rgba(80, 50, 25, 0.7);
    border-color: rgba(180, 120, 60, 0.5);
}

#interaction-title {
    font-size: 36px;
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-sm);
}

#interaction-body {
    margin-bottom: var(--spacing-sm);
    align-items: center;
    align-self: stretch;
    flex-shrink: 1;
    overflow: scroll;
}

.interaction-info {
    font-size: 28px;
    color: rgb(180, 160, 130);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.interaction-info-highlight {
    font-size: 28px;
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

#interaction-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
    margin-top: var(--spacing-xs);
    flex-shrink: 0;
}

#interaction-actions Button {
    min-width: 180px;
    min-height: 80px;
    background-color: rgba(100, 70, 30, 0.5);
    border-width: 1px;
    border-color: rgba(180, 120, 50, 0.3);
    border-radius: var(--radius-sm);
    color: rgb(220, 200, 160);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
}

#interaction-actions Button:hover {
    background-color: rgba(120, 85, 35, 0.65);
    border-color: rgba(200, 140, 60, 0.5);
}

/* Primary action button */
.interaction-btn-primary {
    background-color: rgba(160, 100, 30, 0.6) !important;
    border-color: rgba(220, 160, 50, 0.5) !important;
    color: rgb(255, 220, 150) !important;
}

.interaction-btn-primary:hover {
    background-color: rgba(180, 115, 35, 0.75) !important;
    border-color: rgba(240, 180, 60, 0.7) !important;
}

/* Section header within interaction body */
.interaction-section-header {
    font-size: 24px;
    color: rgb(200, 180, 140);
    -unity-font-style: bold;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    -unity-text-align: upper-center;
}

/* ── Seed Card (plot seed picker) ── */

.seed-picker-scroll {
    max-height: 900px;
    flex-grow: 1;
    align-self: stretch;
}

.seed-picker-list {
    flex-direction: column;
    padding: var(--spacing-xs) 0;
}

.seed-card {
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(50, 35, 18, 0.7);
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-left-width: 6px;
    border-radius: var(--radius-md);
    padding: 0;
    margin-bottom: var(--spacing-xs);
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.seed-card:hover {
    background-color: rgba(70, 48, 24, 0.8);
    border-color: rgba(200, 140, 50, 0.5);
}

/* Hero seed icon area */
.seed-card--icon {
    width: 120px;
    height: 120px;
    border-radius: 12px;
    background-color: rgba(40, 28, 15, 0.6);
    border-width: 1px;
    border-color: rgba(180, 130, 60, 0.25);
    margin: var(--spacing-xs);
    margin-left: var(--spacing-sm);
    flex-shrink: 0;
    align-self: center;
}

/* Right-side info column */
.seed-card--info {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-sm);
    padding-left: var(--spacing-sm);
}

/* Top row: name + stats + count */
.seed-card--title-row {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 4px;
}

.seed-card--name {
    font-size: var(--font-md);
    color: rgb(240, 220, 180);
    -unity-font-style: bold;
}

.seed-card--right-group {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: baseline;
}

.seed-card--stats-line {
    font-size: 18px;
    color: rgb(140, 125, 95);
    margin-right: var(--spacing-xs);
}

.seed-card--count {
    font-size: var(--font-xs);
    color: rgb(160, 140, 100);
    -unity-font-style: bold;
}

/* Recipe tags row (no header) */
.seed-card--recipe-tags {
    flex-direction: row;
    flex-wrap: wrap;
}

.seed-card--tag {
    background-color: rgba(100, 75, 35, 0.5);
    border-radius: 6px;
    padding: 3px 8px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.seed-card--tag Label {
    font-size: 18px;
    color: rgb(200, 170, 110);
}

.seed-card--plant-btn {
    align-self: stretch;
    min-height: 64px;
    background-color: rgba(80, 120, 40, 0.5);
    border-width: 1px;
    border-color: rgba(120, 180, 60, 0.4);
    border-radius: var(--radius-sm);
    color: rgb(200, 240, 150);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
}

.seed-card--plant-btn:hover {
    background-color: rgba(95, 140, 48, 0.65);
    border-color: rgba(140, 200, 70, 0.6);
}

/* ── Flame Level & Mana ── */

.flame-level-badge {
    font-size: var(--font-lg);
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xxs);
}

.flame-mana-rate {
    font-size: var(--font-sm);
    color: rgb(180, 160, 130);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-sm);
}

/* ── Flame Section Divider ── */

.flame-section-divider {
    align-self: stretch;
    height: 1px;
    background-color: rgba(180, 120, 60, 0.25);
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
}

/* ── Flame Build Header (label + cap badge) ── */

.flame-build-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    margin-bottom: var(--spacing-xs);
    padding: 0 var(--spacing-xs);
}

.flame-cap-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(80, 60, 25, 0.5);
    border-radius: 12px;
    padding: 4px 12px;
}

.flame-cap-badge--full {
    background-color: rgba(160, 60, 30, 0.35);
}

.flame-cap-label {
    font-size: var(--font-xs);
    color: rgb(200, 170, 110);
    -unity-font-style: bold;
}

.flame-cap-badge--full .flame-cap-label {
    color: rgb(220, 100, 80);
}

/* ── Upgrade Cost List (flame) ── */

.upgrade-cost-list {
    align-self: stretch;
    margin-bottom: var(--spacing-sm);
}

.upgrade-cost-header {
    font-size: var(--font-xs);
    color: rgb(160, 140, 100);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
    letter-spacing: 2px;
}

.upgrade-cost-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px var(--spacing-sm);
    margin-bottom: 4px;
    background-color: rgba(50, 35, 18, 0.5);
    border-radius: 6px;
}

.upgrade-cost-name {
    font-size: var(--font-sm);
    color: rgb(210, 190, 150);
}

.upgrade-cost-amount {
    font-size: var(--font-sm);
    -unity-font-style: bold;
}

.upgrade-cost-amount--have {
    color: rgb(120, 200, 80);
}

.upgrade-cost-amount--need {
    color: rgb(220, 90, 70);
}

.upgrade-btn {
    align-self: stretch;
    min-height: 80px;
    background-color: rgba(160, 100, 30, 0.6);
    border-width: 2px;
    border-color: rgba(220, 160, 50, 0.5);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 150);
    font-size: var(--font-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.upgrade-btn:hover {
    background-color: rgba(180, 115, 35, 0.75);
    border-color: rgba(240, 180, 60, 0.7);
}

.upgrade-btn:disabled {
    background-color: rgba(40, 30, 18, 0.4);
    border-color: rgba(100, 70, 35, 0.2);
    color: rgb(120, 100, 75);
}

/* ── Build card grid (2-column wrapping layout in popups) ── */

.build-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
    margin-top: 8px;
}

.build-grid > * {
    width: 48%;
    flex-shrink: 0;
    margin: 1%;
}

.build-grid .build-card {
    width: 100%;
}

/* ── Water Subscribe Bell ── */

.water-subscribe-bell {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(180, 160, 130);
}

/* ── Harvest Result ── */

.harvest-yield-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
}

.harvest-seed-icon {
    width: 64px;
    height: 64px;
    margin-right: var(--spacing-sm);
    -unity-background-scale-mode: scale-to-fit;
}

.harvest-yield-label {
    font-size: 32px;
    color: rgb(240, 220, 180);
    -unity-font-style: bold;
}

.harvest-match-badge {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-sm);
    padding: 4px 16px;
    border-radius: 8px;
}

.harvest-match--perfect {
    color: rgb(120, 200, 80);
    background-color: rgba(120, 200, 80, 0.15);
}

.harvest-match--good {
    color: rgb(220, 180, 60);
    background-color: rgba(220, 180, 60, 0.15);
}

.harvest-match--weak {
    color: rgb(220, 120, 70);
    background-color: rgba(220, 120, 70, 0.15);
}

.harvest-axis-row {
    flex-direction: row;
    align-items: center;
    padding: 4px var(--spacing-sm);
    margin-bottom: 2px;
    background-color: rgba(50, 35, 18, 0.4);
    border-radius: 4px;
    align-self: stretch;
}

.harvest-axis-name {
    font-size: 22px;
    color: rgb(180, 160, 130);
    width: 25%;
}

.harvest-axis-actual {
    font-size: 22px;
    color: rgb(220, 200, 160);
    -unity-font-style: bold;
    width: 25%;
    -unity-text-align: upper-center;
}

.harvest-axis-ideal {
    font-size: 20px;
    color: rgb(140, 120, 90);
    width: 35%;
    -unity-text-align: upper-center;
}

.harvest-axis-pass {
    font-size: 24px;
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    width: 15%;
    -unity-text-align: upper-center;
}

.harvest-axis-fail {
    font-size: 24px;
    color: rgb(220, 90, 70);
    -unity-font-style: bold;
    width: 15%;
    -unity-text-align: upper-center;
}
