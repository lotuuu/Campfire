/* Interaction.uss — Camp object interaction popup */

#interaction-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    display: none;
}

#interaction-panel {
    width: 92%;
    max-height: 85%;
    overflow: hidden;
    background-color: rgba(30, 20, 12, 0.95);
    border-width: 2px;
    border-color: rgba(180, 120, 60, 0.4);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md) var(--spacing-md);
    flex-direction: column;
    align-items: center;
    display: none;
}

#interaction-close {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    width: 67px;
    height: 67px;
    background-color: rgba(60, 40, 20, 0.6);
    background-image: url("project://database/Assets/ThirdParty/icons/lorc-cross-mark.png");
    -unity-background-image-tint-color: rgb(200, 120, 100);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: 28px;
    padding: 10px;
}

#interaction-close:hover {
    background-color: rgba(80, 50, 25, 0.7);
    border-color: rgba(180, 120, 60, 0.5);
}

.interaction-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
    align-self: stretch;
    position: relative;
}

#interaction-title {
    font-size: 43px;
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    flex-grow: 1;
    flex-shrink: 1;
}

#interaction-body {
    margin-bottom: var(--spacing-sm);
    align-items: center;
    align-self: stretch;
    flex-shrink: 1;
    overflow: scroll;
}

.interaction-info {
    font-size: 28px;
    color: rgb(180, 160, 130);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.interaction-info-highlight {
    font-size: 28px;
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

#interaction-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
    margin-top: var(--spacing-xs);
    flex-shrink: 0;
}

#interaction-actions Button {
    min-width: 180px;
    min-height: 80px;
    background-color: rgba(100, 70, 30, 0.5);
    border-width: 1px;
    border-color: rgba(180, 120, 50, 0.3);
    border-radius: var(--radius-sm);
    color: rgb(220, 200, 160);
    font-size: 26px;
    -unity-text-align: middle-center;
    margin: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
}

#interaction-actions Button:hover {
    background-color: rgba(120, 85, 35, 0.65);
    border-color: rgba(200, 140, 60, 0.5);
}

/* Primary action button */
.interaction-btn-primary {
    background-color: rgba(160, 100, 30, 0.6) !important;
    border-color: rgba(220, 160, 50, 0.5) !important;
    color: rgb(255, 220, 150) !important;
}

.interaction-btn-primary:hover {
    background-color: rgba(180, 115, 35, 0.75) !important;
    border-color: rgba(240, 180, 60, 0.7) !important;
}

/* Section header within interaction body */
.interaction-section-header {
    font-size: 24px;
    color: rgb(200, 180, 140);
    -unity-font-style: bold;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
    -unity-text-align: upper-center;
}

/* ── Seed Card (plot seed picker) ── */

.seed-picker-scroll {
    max-height: 900px;
    flex-grow: 1;
    align-self: stretch;
}

.seed-picker-list {
    flex-direction: column;
    padding: var(--spacing-xs) 0;
}

.seed-picker-empty {
    -unity-text-align: middle-center;
    color: var(--color-text-muted);
    font-size: var(--font-sm);
    padding: var(--spacing-lg) var(--spacing-md);
    white-space: normal;
}

.seed-card {
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(50, 35, 18, 0.7);
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-left-width: 8px;
    border-radius: var(--radius-md);
    padding: 0;
    margin-bottom: var(--spacing-sm);
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.seed-card:hover {
    background-color: rgba(70, 48, 24, 0.8);
    border-color: rgba(200, 140, 50, 0.5);
}

/* Hero seed icon area */
.seed-card--icon {
    width: 160px;
    height: 160px;
    border-radius: 14px;
    background-color: rgba(40, 28, 15, 0.6);
    border-width: 1px;
    border-color: rgba(180, 130, 60, 0.25);
    margin: var(--spacing-sm);
    margin-left: var(--spacing-sm);
    flex-shrink: 0;
    align-self: center;
}

/* Right-side info column */
.seed-card--info {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-md);
    padding-left: var(--spacing-sm);
}

/* Top row: name + stats + count */
.seed-card--title-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 6px;
}

.seed-card--name {
    font-size: var(--font-lg);
    color: rgb(240, 220, 180);
    -unity-font-style: bold;
}

.seed-card--right-group {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
}

.seed-card--stats-line {
    font-size: var(--font-sm);
    color: rgb(140, 125, 95);
    margin-right: var(--spacing-xs);
}

.seed-card--count {
    font-size: var(--font-md);
    color: rgb(160, 140, 100);
    -unity-font-style: bold;
}

/* Recipe tags row (no header) */
.seed-card--recipe-tags {
    flex-direction: row;
    flex-wrap: wrap;
}

.seed-card--tag {
    background-color: rgba(100, 75, 35, 0.5);
    border-radius: 8px;
    padding: 6px 12px;
    margin-right: 10px;
    margin-bottom: 6px;
}

.seed-card--tag Label {
    font-size: var(--font-sm);
    color: rgb(200, 170, 110);
}

.seed-card--weather-match {
    font-size: var(--font-sm);
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    margin-top: 6px;
}

.seed-card--plant-btn {
    align-self: stretch;
    min-height: 64px;
    background-color: rgba(80, 120, 40, 0.5);
    border-width: 1px;
    border-color: rgba(120, 180, 60, 0.4);
    border-radius: var(--radius-sm);
    color: rgb(200, 240, 150);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
}

.seed-card--plant-btn:hover {
    background-color: rgba(95, 140, 48, 0.65);
    border-color: rgba(140, 200, 70, 0.6);
}

/* ── Flame Level & Mana ── */

.flame-level-badge {
    font-size: var(--font-lg);
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xxs);
}

.flame-mana-rate {
    font-size: var(--font-sm);
    color: rgb(180, 160, 130);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-sm);
}

/* ── Flame Section Divider ── */

.flame-section-divider {
    align-self: stretch;
    height: 1px;
    background-color: rgba(180, 120, 60, 0.25);
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
}

/* ── Flame Build Header (label + cap badge) ── */

.flame-build-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    margin-bottom: var(--spacing-xs);
    padding: 0 var(--spacing-xs);
}

.flame-cap-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(80, 60, 25, 0.5);
    border-radius: 12px;
    padding: 4px 12px;
}

.flame-cap-badge--full {
    background-color: rgba(160, 60, 30, 0.35);
}

.flame-cap-label {
    font-size: var(--font-xs);
    color: rgb(200, 170, 110);
    -unity-font-style: bold;
}

.flame-cap-badge--full .flame-cap-label {
    color: rgb(220, 100, 80);
}

/* ── Upgrade Cost List (flame) ── */

.upgrade-cost-list {
    align-self: stretch;
    margin-bottom: var(--spacing-sm);
}

.upgrade-cost-header {
    font-size: var(--font-xs);
    color: rgb(160, 140, 100);
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
    letter-spacing: 2px;
}

.upgrade-cost-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px var(--spacing-sm);
    margin-bottom: 4px;
    background-color: rgba(50, 35, 18, 0.5);
    border-radius: 6px;
}

.upgrade-cost-name {
    font-size: var(--font-sm);
    color: rgb(210, 190, 150);
}

.upgrade-cost-amount {
    font-size: var(--font-sm);
    -unity-font-style: bold;
}

.upgrade-cost-amount--have {
    color: rgb(120, 200, 80);
}

.upgrade-cost-amount--need {
    color: rgb(220, 90, 70);
}

.upgrade-btn {
    align-self: stretch;
    min-height: 80px;
    background-color: rgba(160, 100, 30, 0.6);
    border-width: 2px;
    border-color: rgba(220, 160, 50, 0.5);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 150);
    font-size: var(--font-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.upgrade-btn:hover {
    background-color: rgba(180, 115, 35, 0.75);
    border-color: rgba(240, 180, 60, 0.7);
}

.upgrade-btn:disabled {
    background-color: rgba(40, 30, 18, 0.4);
    border-color: rgba(100, 70, 35, 0.2);
    color: rgb(120, 100, 75);
}

/* ── Build card grid (2-column wrapping layout in popups) ── */

.build-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: stretch;
    margin-top: 8px;
}

.build-grid > * {
    width: 48%;
    flex-shrink: 0;
    margin: 1%;
}

.build-grid .build-card {
    width: 100%;
}

/* ── Paint Brush Icon Button (top-left) ── */

.interaction-paint {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    width: 67px;
    height: 67px;
    background-color: rgba(60, 40, 20, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(200, 170, 120);
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: var(--radius-sm);
    padding: 10px;
}

.interaction-paint:hover {
    background-color: rgba(80, 50, 25, 0.7);
    border-color: rgba(180, 120, 60, 0.5);
}

/* ── Water Subscribe Bell ── */

.water-subscribe-bell {
    position: absolute;
    right: 67px;
    top: 0;
    width: 53px;
    height: 53px;
    background-color: rgba(60, 40, 20, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(180, 160, 130);
    border-width: 1px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: var(--radius-sm);
    padding: 6px;
}

/* ══════════════════════════════════════════════════════
   HARVEST RESULT — animated reveal with hero icon
   ══════════════════════════════════════════════════════ */

/* ── Hero: large icon with glow ring ── */
.harvest-hero {
    align-self: center;
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
    /* Animate: scale in from 0 */
    scale: 0;
    transition-property: scale;
    transition-duration: 350ms;
    transition-timing-function: ease-out;
}

.harvest-hero.harvest-hero--visible {
    scale: 1;
}

.harvest-glow-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 90px;
    border-width: 3px;
    border-color: rgba(255, 230, 170, 0.5);
    opacity: 0;
    scale: 1.3;
    transition-property: opacity, scale;
    transition-duration: 500ms;
    transition-timing-function: ease-out;
}

.harvest-hero--visible > .harvest-glow-ring {
    opacity: 1;
    scale: 1;
}

/* Tier glow colors */
.harvest-glow--tier0 { border-color: rgba(255, 230, 170, 0.5); }
.harvest-glow--tier1 { border-color: rgba(80, 190, 100, 0.6); }
.harvest-glow--tier2 { border-color: rgba(80, 150, 220, 0.6); }
.harvest-glow--tier3 { border-color: rgba(170, 100, 220, 0.6); }
.harvest-glow--tier4 { border-color: rgba(255, 200, 60, 0.7); }

.harvest-hero-icon {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Item name ── */
.harvest-result-name {
    font-size: var(--font-lg);
    color: rgb(240, 220, 180);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xxs);
    /* Animate: fade + slide up */
    opacity: 0;
    translate: 0 20px;
    transition-property: opacity, translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

/* ── Yield count row ── */
.harvest-yield-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
    /* Animate: fade + slide up */
    opacity: 0;
    translate: 0 16px;
    transition-property: opacity, translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.harvest-yield-count {
    font-size: var(--font-xxl);
    color: var(--color-text-accent);
    -unity-font-style: bold;
}

.harvest-bonus-label {
    font-size: var(--font-xl);
    color: rgb(130, 220, 110);
    -unity-font-style: bold;
    margin-left: var(--spacing-xs);
}

/* ── Quality badge: text + percentage ── */
.harvest-match-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-xs);
    /* Animate: fade + slide up */
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

/* ── Harvest "tap to close" hint ── */
.harvest-tap-hint {
    font-size: var(--font-xs);
    color: rgb(140, 120, 90);
    -unity-text-align: upper-center;
    margin-top: var(--spacing-md);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

/* Shared reveal animation class — must come AFTER elements it overrides */
.harvest-reveal--visible {
    opacity: 1;
    translate: 0 0;
}

.harvest-match-badge {
    font-size: var(--font-md);
    -unity-font-style: bold;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-sm);
    -unity-text-align: middle-center;
}

.harvest-match-pct {
    font-size: var(--font-xl);
    -unity-font-style: bold;
    margin-left: var(--spacing-sm);
}

.harvest-match--perfect {
    color: rgb(120, 200, 80);
    background-color: rgba(120, 200, 80, 0.15);
}

.harvest-match--good {
    color: rgb(220, 180, 60);
    background-color: rgba(220, 180, 60, 0.15);
}

.harvest-match--weak {
    color: rgb(220, 120, 70);
    background-color: rgba(220, 120, 70, 0.15);
}

/* pct label inherits color from match class but no background */
.harvest-match-pct.harvest-match--perfect { background-color: rgba(0,0,0,0); }
.harvest-match-pct.harvest-match--good { background-color: rgba(0,0,0,0); }
.harvest-match-pct.harvest-match--weak { background-color: rgba(0,0,0,0); }

/* ── Animated quality bar ── */
.harvest-quality-track {
    align-self: stretch;
    height: 16px;
    background-color: rgba(40, 30, 15, 0.5);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(180, 120, 60, 0.2);
    overflow: hidden;
    margin-bottom: var(--spacing-md);
}

.harvest-quality-fill {
    height: 100%;
    width: 0;
    border-radius: 8px;
    transition-property: width;
    transition-duration: 600ms;
    transition-timing-function: ease-out;
}

.harvest-quality-fill.harvest-match--perfect {
    background-color: rgba(120, 200, 80, 0.7);
    border-width: 1px;
    border-color: rgba(120, 200, 80, 0.5);
}

.harvest-quality-fill.harvest-match--good {
    background-color: rgba(220, 180, 60, 0.6);
    border-width: 1px;
    border-color: rgba(220, 180, 60, 0.4);
}

.harvest-quality-fill.harvest-match--weak {
    background-color: rgba(220, 120, 70, 0.5);
    border-width: 1px;
    border-color: rgba(220, 120, 70, 0.4);
}

/* ── Axis breakdown (cascading reveal) ── */
.harvest-axis-container {
    align-self: stretch;
}

.harvest-axis-header {
    font-size: var(--font-xs);
    color: var(--color-text-dim);
    letter-spacing: 2px;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
    /* Animate */
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

.harvest-axis-row {
    flex-direction: row;
    align-items: center;
    padding: 6px var(--spacing-sm);
    margin-bottom: 4px;
    background-color: rgba(50, 35, 18, 0.5);
    border-radius: var(--radius-sm);
    border-left-width: 4px;
    border-left-color: rgba(180, 120, 60, 0.3);
    align-self: stretch;
    /* Animate: fade + slide from left */
    opacity: 0;
    translate: -20px 0;
    transition-property: opacity, translate;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

.harvest-axis-row.harvest-reveal--visible {
    opacity: 1;
    translate: 0 0;
}

.harvest-axis-name {
    font-size: var(--font-xs);
    color: rgb(180, 160, 130);
    width: 25%;
}

.harvest-axis-actual {
    font-size: var(--font-xs);
    color: rgb(220, 200, 160);
    -unity-font-style: bold;
    width: 25%;
    -unity-text-align: upper-center;
}

.harvest-axis-ideal {
    font-size: var(--font-xs);
    color: rgb(140, 120, 90);
    width: 30%;
    -unity-text-align: upper-center;
}

/* Harvest axis pass/fail icons (server-served sprites) */
.harvest-axis-pass-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(120, 200, 80);
    flex-shrink: 0;
    width: 20%;
    align-self: center;
}

.harvest-axis-fail-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 90, 70);
    flex-shrink: 0;
    width: 20%;
    align-self: center;
}

/* ── Vase Water Level Bar ── */

.vase-water-count {
    font-size: var(--font-lg);
    color: var(--color-water);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.vase-level-track {
    align-self: stretch;
    height: 24px;
    background-color: rgba(40, 60, 80, 0.3);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(100, 180, 240, 0.2);
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
}

.vase-level-fill {
    height: 100%;
    border-radius: 12px;
    background-color: rgba(60, 100, 140, 0.3);
    transition-property: width;
    transition-duration: 0.3s;
}

.vase-level-fill--filling {
    background-color: rgba(100, 180, 240, 0.45);
    border-width: 1px;
    border-color: rgba(100, 180, 240, 0.4);
}

.vase-level-fill--full {
    background-color: rgba(100, 180, 240, 0.6);
    border-width: 1px;
    border-color: rgba(100, 180, 240, 0.5);
}

/* ── Growth Progress Bar ── */

.growth-progress-pct {
    font-size: var(--font-lg);
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.growth-progress-track {
    align-self: stretch;
    height: 20px;
    background-color: rgba(40, 60, 30, 0.3);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(120, 180, 60, 0.2);
    overflow: hidden;
    margin-bottom: var(--spacing-xs);
}

.growth-progress-fill {
    height: 100%;
    border-radius: 10px;
    background-color: rgba(120, 180, 60, 0.5);
    border-width: 1px;
    border-color: rgba(120, 180, 60, 0.4);
    transition-property: width;
    transition-duration: 0.3s;
}

/* ── Plot Yield Preview & Ready Badge ── */

.plot-yield-preview {
    font-size: var(--font-md);
    color: rgb(220, 200, 160);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: var(--spacing-xs);
}

.plot-ready-badge {
    font-size: var(--font-md);
    color: rgb(120, 200, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    background-color: rgba(120, 200, 80, 0.12);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-sm);
    margin-bottom: var(--spacing-sm);
    align-self: center;
}

/* ── Flame Level-Up Animation ── */

.flame-flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 200, 80, 0.6);
    transition-property: opacity;
    transition-duration: 500ms;
    transition-timing-function: ease-out;
}

.flame-flash-overlay--fade {
    opacity: 0;
}

.flame-bar-hidden {
    opacity: 0;
    picking-mode: ignore;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

.grid-cell--reveal-hidden {
    scale: 0 0;
    opacity: 0;
}

.grid-cell--reveal {
    scale: 1 1;
    opacity: 1;
    transition-property: scale, opacity;
    transition-duration: 400ms, 300ms;
    transition-timing-function: ease-out, ease-out;
}

.flame-levelup-badge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: ignore;
}

.flame-levelup-badge__text {
    background-color: rgba(20, 12, 5, 0.9);
    color: #FFD060;
    font-size: 48px;
    -unity-font-style: bold;
    padding: 16px 48px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgba(255, 180, 50, 0.4);
    scale: 0 0;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 350ms, 300ms;
    transition-timing-function: ease-out, ease-out;
}

.flame-levelup-badge__text--visible {
    opacity: 1;
}

.flame-levelup-badge__text--fade {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 600ms;
    transition-timing-function: ease-out;
}
