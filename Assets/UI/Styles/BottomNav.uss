/* Bottom navigation tab bar */

#bottom-nav {
    flex-direction: row;
    align-self: stretch;
    padding: var(--spacing-sm) var(--spacing-xs);
    padding-bottom: var(--spacing-lg);
    background-color: rgba(8, 16, 24, 0.92);
    border-top-width: 2px;
    border-top-color: rgba(140, 230, 240, 0.20);
    min-height: 148px;
}

.nav-tab {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: var(--spacing-xxs) var(--spacing-xs);
    margin: 0 var(--spacing-xs);
    min-height: 140px;
    justify-content: center;
    align-items: center;
}

.nav-tab-bar {
    align-self: stretch;
    height: 3px;
    background-color: rgba(140, 230, 240, 0.18);
    justify-content: center;
    align-items: center;
    overflow: visible;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.nav-icon {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(185, 210, 225);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.2s;
}

.nav-tab-active .nav-tab-bar {
    background-color: rgb(100, 230, 230);
}

.nav-tab-active .nav-icon {
    -unity-background-image-tint-color: rgb(100, 230, 230);
}

.nav-tab-disabled .nav-icon {
    -unity-background-image-tint-color: rgba(140, 165, 185, 0.40);
}

.nav-tab:hover .nav-icon {
    -unity-background-image-tint-color: rgb(220, 238, 245);
}

.nav-tab-disabled:hover .nav-icon {
    -unity-background-image-tint-color: rgba(140, 165, 185, 0.40);
}

.nav-label {
    font-size: var(--font-xs);
    color: rgb(185, 210, 225);
    -unity-text-align: middle-center;
    margin-top: var(--spacing-xxs);
    transition-property: color;
    transition-duration: 0.2s;
}

.nav-tab-active .nav-label {
    color: rgb(100, 230, 230);
}

.nav-tab-disabled .nav-label {
    color: rgba(140, 165, 185, 0.40);
}

.nav-tab:hover .nav-label {
    color: rgb(220, 238, 245);
}

.nav-tab-disabled:hover .nav-label {
    color: rgba(140, 165, 185, 0.40);
}

/* Expand caret: morphs in from the bar position when terrarium is expandable */
.nav-expand-caret {
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(100, 230, 230);
    align-self: stretch;
    opacity: 0;
    scale: 0.3 0.3;
    translate: 0 8px;
    transition-property: opacity, scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

/* When expandable: bar fades out slightly ahead; caret scales+rises in */
.nav-tab-expandable .nav-tab-bar {
    background-color: transparent;
}

.nav-tab-expandable .nav-expand-caret {
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

/* Per-tab icon images */
#tab-codex .nav-icon {
    background-image: url('../../ThirdParty/icons/lorc-open-book.png');
}

#tab-shop .nav-icon {
    background-image: url('../../ThirdParty/icons/delapouite-shopping-cart.png');
}

#tab-terrarium .nav-icon {
    background-image: url('../../ThirdParty/icons/lorc-flower-pot.png');
}

#tab-greenhouse .nav-icon {
    background-image: url('../../ThirdParty/icons/delapouite-greenhouse.png');
}

#tab-construction .nav-icon {
    background-image: url('../../ThirdParty/icons/delapouite-3d-hammer.png');
}

/* ─── Environment Switcher Bar ───────────────────────────── */

.env-switcher-bar {
    flex-direction: row;
    align-self: stretch;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: rgba(8, 16, 24, 0.92);
    border-top-width: 1px;
    border-top-color: rgba(140, 230, 240, 0.15);
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    translate: 0 100%;
}

.env-switcher-bar--visible {
    translate: 0 0%;
}

.env-switcher-bar--hidden {
    translate: 0 100%;
}

.env-pill {
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(140, 230, 240, 0.35);
    border-radius: 20px;
    padding: var(--spacing-xs) var(--spacing-sm);
    margin: 0 var(--spacing-xs);
    color: rgba(185, 210, 225, 0.85);
    font-size: var(--font-xs);
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.env-pill--active {
    background-color: rgba(100, 230, 230, 0.18);
    border-color: rgb(100, 230, 230);
    color: rgb(100, 230, 230);
}

.env-pill:hover {
    background-color: rgba(100, 230, 230, 0.10);
    border-color: rgba(140, 230, 240, 0.65);
}
