/* Bottom navigation tab bar */

#bottom-nav {
    flex-direction: row;
    align-self: stretch;
    padding: var(--spacing-sm) var(--spacing-xs);
    padding-bottom: var(--spacing-lg);
    background-color: rgba(8, 16, 24, 0.92);
    border-top-width: 2px;
    border-top-color: rgba(140, 230, 240, 0.20);
    min-height: 120px;
}

.nav-tab {
    flex-grow: 1;
    background-color: transparent;
    color: rgb(185, 210, 225);
    border-width: 0;
    border-top-width: 3px;
    border-top-color: transparent;
    border-radius: 0;
    padding: var(--spacing-sm) var(--spacing-xs);
    margin: 0 var(--spacing-xs);
    min-height: 110px;
    font-size: var(--font-md);
    -unity-text-align: middle-center;
    transition-property: color, border-top-color;
    transition-duration: 0.2s;
}

.nav-tab-active {
    color: rgb(100, 230, 230);
    border-top-color: rgb(100, 230, 230);
}

.nav-tab-disabled {
    color: rgba(140, 165, 185, 0.45);
}

.nav-tab:hover {
    color: rgb(220, 238, 245);
}

.nav-tab-disabled:hover {
    color: rgba(140, 165, 185, 0.45);
}
