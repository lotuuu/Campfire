/* Dialogue.uss — VN-style dialogue */

/* Dim backdrop + portrait (absolute overlay) */
#dialogue-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: flex-end;
}

#dialogue-speaker-portrait {
    position: absolute;
    bottom: 250px;
    right: -5%;
    width: 55%;
    height: 40%;
    -unity-background-scale-mode: scale-to-fit;
    scale: -1 1;
}

/* Dialogue box — flow element that replaces bottom-nav */
#dialogue-box {
    background-color: var(--color-bg-panel);
    border-top-width: 3px;
    border-top-color: var(--color-border-accent);
    padding: var(--spacing-md);
    height: var(--bottom-bar-height);
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

#dialogue-speaker {
    font-size: var(--font-lg);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-xxs);
}

#dialogue-text {
    font-size: var(--font-md);
    color: var(--color-text);
    white-space: normal;
}

#dialogue-tap-hint {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-text-align: lower-right;
}

/* Above-nav variant: dialogue sits above the menu bar */
.dialogue-overlay--above-nav {
    background-color: rgba(0, 0, 0, 0.4);
    padding-bottom: var(--bottom-bar-height);
}
