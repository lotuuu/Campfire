/* CampSite.uss — Main campsite view styling */

/* ── Root container ── */
#camp-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(18, 12, 8);
}

/* ── Resource bar ── */
#resource-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: rgba(30, 18, 10, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 120, 60, 0.15);
}

#mana-display,
#water-display {
    font-size: var(--font-sm);
    color: rgb(230, 210, 180);
    margin-left: var(--spacing-md);
    margin-right: var(--spacing-md);
}

#mana-display {
    color: rgb(255, 170, 60);
}

#water-display {
    color: rgb(100, 180, 240);
}

/* ── Campsite main view ── */
#campsite-view {
    flex-grow: 1;
}

/* ScrollView inner container */
#campsite-view > #unity-content-container {
    align-items: center;
    padding: var(--spacing-md);
}

/* ── Flame ── */
#flame-container {
    align-items: center;
    justify-content: center;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

#flame {
    width: 160px;
    height: 160px;
    border-radius: 80px;
    background-color: rgb(220, 100, 20);
    border-width: 4px;
    border-color: rgba(255, 180, 60, 0.6);
    align-items: center;
    justify-content: center;
}

#flame:hover {
    background-color: rgb(240, 120, 30);
    border-color: rgba(255, 200, 80, 0.8);
}

#flame-level {
    font-size: var(--font-lg);
    color: rgb(255, 240, 200);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Camp object containers ── */
#plots-container,
#vases-container,
#gardens-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    padding: var(--spacing-xs);
}

/* ── Section labels ── */
.section-label {
    font-size: var(--font-xs);
    color: rgba(200, 170, 130, 0.5);
    -unity-text-align: upper-center;
    width: 100%;
    margin-bottom: var(--spacing-xxs);
    letter-spacing: 2px;
    -unity-font-style: bold-and-italic;
}

/* ── Individual camp objects ── */
.plot-item {
    width: 140px;
    height: 160px;
    background-color: rgba(60, 40, 20, 0.7);
    border-width: 2px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: var(--radius-md);
    padding: var(--spacing-xs);
    margin: var(--spacing-xxs);
    align-items: center;
    justify-content: space-between;
    flex-direction: column;
}

.plot-item:hover {
    border-color: rgba(255, 180, 60, 0.5);
    background-color: rgba(70, 48, 25, 0.8);
}

.plot-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background-color: rgba(100, 80, 40, 0.4);
    margin-bottom: var(--spacing-xxs);
}

.plot-state {
    font-size: var(--font-xs);
    color: rgb(200, 170, 130);
    -unity-text-align: upper-center;
}

.plot-progress {
    width: 100%;
    height: 8px;
    background-color: rgba(40, 30, 15, 0.6);
    border-radius: 4px;
    overflow: hidden;
}

.plot-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(120, 180, 60);
    border-radius: 4px;
}

.plot-action {
    width: 100%;
    height: 36px;
    font-size: var(--font-xs);
    color: rgb(255, 240, 200);
    background-color: rgba(180, 110, 30, 0.5);
    border-width: 1px;
    border-color: rgba(220, 150, 50, 0.3);
    border-radius: var(--radius-sm);
    -unity-text-align: middle-center;
}

.plot-action:hover {
    background-color: rgba(200, 130, 40, 0.7);
}

.plot-action:disabled {
    background-color: rgba(60, 40, 20, 0.4);
    color: rgba(200, 170, 130, 0.4);
}

.vase-item {
    width: 120px;
    height: 150px;
    background-color: rgba(50, 35, 25, 0.7);
    border-width: 2px;
    border-color: rgba(120, 90, 50, 0.3);
    border-radius: var(--radius-md);
    padding: var(--spacing-xs);
    margin: var(--spacing-xxs);
    align-items: center;
    justify-content: space-between;
    flex-direction: column;
}

.vase-item:hover {
    border-color: rgba(100, 180, 240, 0.5);
    background-color: rgba(55, 40, 28, 0.8);
}

.vase-icon {
    width: 40px;
    height: 48px;
    border-radius: 8px;
    background-color: rgba(80, 120, 180, 0.3);
    margin-bottom: var(--spacing-xxs);
}

.vase-water {
    font-size: var(--font-sm);
    color: rgb(100, 180, 240);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.vase-state {
    font-size: 20px;
    color: rgba(200, 170, 130, 0.6);
    -unity-text-align: upper-center;
}

.vase-action {
    width: 100%;
    height: 36px;
    font-size: var(--font-xs);
    color: rgb(200, 230, 255);
    background-color: rgba(40, 80, 140, 0.4);
    border-width: 1px;
    border-color: rgba(80, 150, 220, 0.3);
    border-radius: var(--radius-sm);
    -unity-text-align: middle-center;
}

.vase-action:hover {
    background-color: rgba(50, 100, 170, 0.6);
}

.vase-action:disabled {
    background-color: rgba(30, 40, 55, 0.4);
    color: rgba(150, 170, 190, 0.4);
}

.garden-item {
    width: 140px;
    height: 140px;
    background-color: rgba(25, 50, 20, 0.7);
    border-width: 2px;
    border-color: rgba(60, 120, 40, 0.3);
    border-radius: var(--radius-md);
    padding: var(--spacing-xs);
    margin: var(--spacing-xxs);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.garden-item:hover {
    border-color: rgba(100, 200, 60, 0.5);
    background-color: rgba(30, 58, 24, 0.8);
}

.garden-name {
    font-size: var(--font-xs);
    color: rgb(140, 200, 100);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.garden-state {
    font-size: 20px;
    color: rgba(200, 170, 130, 0.6);
    -unity-text-align: upper-center;
}
