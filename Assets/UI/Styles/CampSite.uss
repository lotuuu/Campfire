/* CampSite.uss — Main campsite view styling */

/* ── Root container ── */
#camp-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-bg-dark);
}

/* ── Campsite grid viewport ── */
#campsite-viewport {
    flex-grow: 1;
    overflow: hidden;
}

#campsite-canvas {
    position: absolute;
}

/* ── Diagonal wipe transition ── */
#wipe-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    display: none;
}

.wipe-layer {
    position: absolute;
    width: 200%;
    height: 200%;
    -unity-background-scale-mode: scale-and-crop;
    translate: -120% -120%;
}

#wipe-layer-0 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition2.png");
}

#wipe-layer-1 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition2.png");
}

#wipe-layer-2 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition1.png");
}

#wipe-layer-3 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition3.png");
    width: 300%;
    height: 300%;
}

