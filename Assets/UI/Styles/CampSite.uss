/* CampSite.uss — Main campsite view styling */

/* ── Root container ── */
#camp-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--color-bg-dark);
}

/* ── Top bar frame ── */
#top-bar {
    flex-shrink: 0;
    padding: var(--spacing-md);
    margin: 0;
    background-color: rgb(36, 61, 28);
    border-bottom-width: 3px;
    border-color: rgb(214, 154, 53);
    border-radius: 0;
    transition-property: opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
}

/* ── Header row ── */
#top-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-sm);
}

#player-name {
    font-size: var(--font-xl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.icon-btn {
    background-color: transparent;
    border-width: 0;
    padding: 4px;
    margin-left: var(--spacing-xs);
}

.debug-btn {
    background-color: transparent;
    border-width: 0;
    padding: 2px 6px;
    margin-left: var(--spacing-xs);
    font-size: var(--font-xs);
    color: var(--color-text-dim);
}

.settings-icon-btn {
    width: 48px;
    height: 48px;
    padding: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text-dim);
}

.header-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text-dim);
}

#top-header-spacer {
    flex-grow: 1;
}

#date-time {
    font-size: var(--font-md);
    color: var(--color-text-dim);
}

/* ── Resource bar (inside top-bar, lower-right) ── */
#resource-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-top: var(--spacing-xs);
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: var(--spacing-lg);
}

.resource-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-xs);
}

#mana-display {
    font-size: var(--font-md);
    color: var(--color-mana);
}

#water-display {
    font-size: var(--font-md);
    color: var(--color-water);
}

#mallum-display {
    font-size: var(--font-md);
    color: var(--color-text);
}

/* ── Campsite grid viewport ── */
#campsite-viewport {
    flex-grow: 1;
    overflow: hidden;
}

#campsite-canvas {
    position: absolute;
}

/* ── Diagonal wipe transition ── */
#wipe-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    display: none;
}

.wipe-layer {
    position: absolute;
    width: 200%;
    height: 200%;
    -unity-background-scale-mode: scale-and-crop;
    translate: -120% -120%;
}

#wipe-layer-0 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition2.png");
}

#wipe-layer-1 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition2.png");
}

#wipe-layer-2 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition1.png");
}

#wipe-layer-3 {
    background-image: url("project://database/Assets/UI/Transition/TX_Transition3.png");
}

