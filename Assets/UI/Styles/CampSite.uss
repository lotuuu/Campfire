/* CampSite.uss — Main campsite view styling */

/* ── Root container ── */
#camp-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(18, 12, 8);
}

/* ── Top bar frame ── */
#top-bar {
    flex-shrink: 0;
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
    background-color: rgba(30, 20, 10, 0.85);
    border-width: 3px;
    border-color: rgba(140, 100, 50, 0.5);
    border-radius: var(--radius-md);
}

/* ── Header row ── */
#top-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-xs);
}

#player-name {
    font-size: var(--font-lg);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

.icon-btn {
    background-color: transparent;
    border-width: 0;
    padding: 4px;
    margin-left: var(--spacing-xs);
}

.header-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text-dim);
}

#top-header-spacer {
    flex-grow: 1;
}

#date-time {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
}

/* ── Resource bar (inside top-bar, lower-right) ── */
#resource-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-top: var(--spacing-xxs);
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: var(--spacing-md);
}

.resource-icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-xxs);
}

#mana-display {
    font-size: var(--font-xs);
    color: var(--color-mana);
}

#water-display {
    font-size: var(--font-xs);
    color: var(--color-water);
}

/* ── Campsite grid viewport ── */
#campsite-viewport {
    flex-grow: 1;
    overflow: hidden;
}

#campsite-canvas {
    position: absolute;
}

/* ── Visit transition curtains ── */
#visit-transition {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
    justify-content: center;
    align-items: center;
}

#curtain-left,
#curtain-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background-color: rgb(18, 12, 8);
    transition-property: translate;
    transition-duration: 400ms;
    transition-timing-function: ease-in-out;
}

#curtain-left {
    left: 0;
    translate: -100% 0;
}

#curtain-right {
    right: 0;
    translate: 100% 0;
}

#visit-transition.curtain-closed #curtain-left {
    translate: 0 0;
}

#visit-transition.curtain-closed #curtain-right {
    translate: 0 0;
}

#curtain-label {
    position: absolute;
    align-self: center;
    font-size: var(--font-lg);
    color: rgb(230, 210, 180);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-delay: 200ms;
}

#visit-transition.curtain-closed #curtain-label {
    opacity: 1;
}
