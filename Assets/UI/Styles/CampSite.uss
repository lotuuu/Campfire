/* CampSite.uss — Main campsite view styling */

/* ── Root container ── */
#camp-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(18, 12, 8);
}

/* ── Resource bar ── */
#resource-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: rgba(30, 18, 10, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 120, 60, 0.15);
}

#mana-display,
#water-display {
    font-size: var(--font-sm);
    color: rgb(230, 210, 180);
    margin-left: var(--spacing-md);
    margin-right: var(--spacing-md);
}

#mana-display {
    color: rgb(255, 170, 60);
}

#water-display {
    color: rgb(100, 180, 240);
}

#gems-display {
    font-size: var(--font-sm);
    color: rgb(160, 220, 100);
    margin-left: var(--spacing-md);
    margin-right: var(--spacing-md);
}

#btn-debug {
    font-size: var(--font-xs);
    color: rgb(255, 100, 100);
    background-color: rgba(255, 50, 50, 0.15);
    border-width: 1px;
    border-color: rgba(255, 100, 100, 0.3);
    border-radius: 6px;
    padding: 4px 8px;
    margin-left: var(--spacing-sm);
}

/* ── Campsite grid viewport ── */
#campsite-viewport {
    flex-grow: 1;
    overflow: hidden;
}

#campsite-canvas {
    position: absolute;
}
