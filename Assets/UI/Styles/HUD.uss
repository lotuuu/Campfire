/* HUD: ResonanceBar + CurrencyDisplay + PulseButton + NavBar */

#hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: space-between;
}

/* Top bar: weather + currency */
#top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--spacing-md);
    padding-top: var(--spacing-lg);
}

#weather-text {
    color: var(--color-text);
    font-size: var(--font-sm);
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
}

#currency-panel {
    align-items: flex-end;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
}

.currency-label {
    color: var(--color-text-accent);
    font-size: var(--font-sm);
    margin-bottom: 4px;
}

/* Bottom area: pulse button + nav */
#bottom-bar {
    align-items: center;
    padding-bottom: var(--spacing-lg);
}

#pulse-button {
    width: 400px;
    height: 110px;
    min-height: 110px;
    font-size: var(--font-lg);
    -unity-font-style: bold;
    background-color: rgba(60, 110, 60, 0.9);
    border-width: 3px;
    border-color: var(--color-border-accent);
    border-radius: 55px;
    margin-bottom: var(--spacing-md);
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}

#pulse-button:hover {
    background-color: rgba(75, 135, 75, 0.95);
    scale: 1.03;
}

#pulse-button:active {
    background-color: rgba(90, 160, 90, 1);
}

/* Nav bar */
#nav-bar {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: rgba(0, 0, 0, 0.5);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
}

.nav-btn {
    flex-grow: 1;
    background-color: var(--color-button-bg);
    color: var(--color-text);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-md);
    margin-left: var(--spacing-xs);
    margin-right: var(--spacing-xs);
    min-height: 88px;
    font-size: var(--font-md);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.nav-btn:hover {
    background-color: var(--color-button-bg-hover);
}

.nav-btn:active {
    background-color: var(--color-button-bg-active);
}
