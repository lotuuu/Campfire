/* HUD: app shell + top bar */
/* Shared glass card style for top-bar elements */
.hud-glass-card {
    background-color: rgba(10, 20, 30, 0.45);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
}


#app-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
}

/* Top bar: weather + currency */
#top-bar {
    flex-direction: row;
    align-items: flex-start;
    padding: var(--spacing-md);
    padding-top: var(--spacing-lg);
}

.top-bar-side {
    flex: 1;
}

#weather-text {
    color: var(--color-text);
    font-size: var(--font-sm);
}

#currency-panel {
    flex: 1;
    align-items: flex-end;
}

#currency-card {
    align-items: flex-end;
}

.currency-label {
    font-size: var(--font-sm);
    margin-bottom: 4px;
}

#gold-text        { color: var(--color-highlight); }
#sun-shards-text  { color: var(--color-sun-shards); }
#pollen-text      { color: var(--color-pollen); }
