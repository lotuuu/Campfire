/* Construction Tab */

/* Vertical list — override Common.uss grid default */
#construction-scroll .unity-scroll-view__content-container {
    flex-direction: column;
    flex-wrap: nowrap;
    padding: var(--spacing-sm);
}

.construction-card {
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

.construction-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xs);
}

.construction-card-name {
    font-size: var(--font-md);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

.construction-card-badge {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.construction-card-badge--unlocked {
    background-image: url('../../ThirdParty/icons/delapouite-check-mark.png');
    -unity-background-image-tint-color: rgb(100, 230, 230);
}

/* Locked state */
.construction-locked-section {
    flex-direction: column;
    align-items: stretch;
}

.construction-unlock-cost {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-xs);
}

/* Unlocked state — upgrade rows */
.construction-upgrades-section {
    flex-direction: column;
}

.construction-upgrade-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--spacing-xs);
}

.construction-upgrade-label {
    font-size: var(--font-sm);
    color: var(--color-text);
    flex-grow: 1;
}

.construction-upgrade-progress {
    font-size: var(--font-xs);
    color: var(--color-text-dim);
    margin-right: var(--spacing-sm);
}

.construction-unlock-btn,
.construction-upgrade-btn {
    min-width: 200px;
}

/* Purchase (locked) card — distinct CTA style */
.construction-card.is-locked {
    background-color: rgba(20, 35, 50, 0.45);
    border-color: var(--color-border-accent);
}

.construction-card.is-locked .construction-card-name {
    color: var(--color-text-accent);
}

.construction-card.is-locked .construction-locked-section {
    align-items: stretch;
    margin-top: var(--spacing-xs);
}

.construction-card.is-locked .construction-unlock-cost {
    -unity-text-align: middle-center;
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-sm);
}

.construction-card.is-locked .construction-unlock-btn {
    min-width: 0;
    align-self: stretch;
    font-size: var(--font-sm);
    -unity-font-style: bold;
}
