* {
    -unity-font-definition: url('project://database/Assets/Fonts/Nunito-Regular.ttf');
}

/* Display font (Fredoka) for headers, titles, and prominent text */
.font-display,
.panel-header,
.gate-title,
.skin-title,
.harvest-yield-count,
#loading-gate-title,
#overlay-title,
#dialogue-speaker,
#tutorial-hint-speaker,
#tutorial-hint-centered-speaker,
#visitor-modal-name,
#reward-reveal-title {
    -unity-font-definition: url('project://database/Assets/Fonts/Fredoka-SemiBold.ttf');
}

:root {
    /* Colors - Camp Fire warm palette */
    --color-bg-dark: rgb(99, 102, 52);
    --color-bg-panel: rgb(85, 55, 20);
    --color-bg-slot: rgb(105, 72, 28);
    --color-bg-slot-hover: rgb(120, 85, 35);
    --color-border: rgb(155, 115, 45);
    --color-border-accent: rgb(200, 150, 50);

    --color-text: rgb(230, 195, 100);
    --color-text-dim: rgb(200, 165, 90);
    --color-text-bright: rgb(245, 210, 110);
    --color-text-accent: rgb(255, 195, 60);

    --color-button-bg: rgb(107, 77, 22);
    --color-button-bg-hover: rgb(127, 93, 30);
    --color-button-bg-active: rgb(147, 107, 35);
    --color-button-bg-disabled: rgb(60, 40, 18);

    /* Resource colors */
    --color-mana: rgb(255, 180, 60);
    --color-water: rgb(100, 180, 240);

    --color-highlight: rgb(255, 210, 70);
    --color-dim: rgb(130, 95, 45);
    --color-empty: rgb(55, 38, 15);

    --color-bg-gate: rgb(30, 20, 8);
    --color-bg-sheet: rgb(70, 46, 16);
    --color-bg-popup: rgb(65, 42, 15);

    /* Spacing - mobile scale at 1080 ref width */
    --spacing-xxs: 4px;
    --spacing-xs: 8px;
    --spacing-sm: 16px;
    --spacing-md: 24px;
    --spacing-lg: 32px;
    --spacing-xl: 48px;

    /* Bottom bar height — shared by nav, tutorial hints, and dialogue */
    --bottom-bar-height: 160px;

    /* Border radius */
    --radius-sm: 8px;
    --radius-md: 16px;
    --radius-lg: 24px;

    /* Font sizes - mobile readable at 1080 ref width */
    --font-xs: 24px;
    --font-sm: 28px;
    --font-md: 32px;
    --font-lg: 40px;
    --font-xl: 52px;
    --font-xxl: 64px;
}
