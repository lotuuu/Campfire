:root {
    /* Colors - Camp Fire warm palette */
    --color-bg-dark: rgb(18, 12, 8);
    --color-bg-panel: rgba(30, 18, 10, 0.85);
    --color-bg-slot: rgba(60, 40, 20, 0.5);
    --color-bg-slot-hover: rgba(80, 55, 30, 0.6);
    --color-border: rgba(140, 100, 50, 0.2);
    --color-border-accent: rgba(220, 150, 50, 0.4);

    --color-text: rgb(230, 210, 180);
    --color-text-dim: rgb(170, 145, 110);
    --color-text-bright: rgb(255, 240, 200);
    --color-text-accent: rgb(255, 180, 60);

    --color-button-bg: rgba(120, 70, 20, 0.4);
    --color-button-bg-hover: rgba(160, 95, 30, 0.55);
    --color-button-bg-active: rgba(200, 120, 40, 0.65);
    --color-button-bg-disabled: rgba(40, 25, 12, 0.35);

    /* Resource colors */
    --color-mana: rgb(255, 170, 60);
    --color-water: rgb(100, 180, 240);

    --color-highlight: rgb(255, 200, 60);
    --color-dim: rgb(120, 90, 60);
    --color-empty: rgba(40, 25, 12, 0.3);

    --color-bg-gate: rgba(18, 12, 8, 0.95);
    --color-bg-sheet: rgba(25, 16, 8, 0.95);
    --color-bg-popup: rgba(20, 14, 8, 0.97);

    /* Spacing - mobile scale at 1080 ref width */
    --spacing-xxs: 4px;
    --spacing-xs: 8px;
    --spacing-sm: 16px;
    --spacing-md: 24px;
    --spacing-lg: 32px;
    --spacing-xl: 48px;

    /* Border radius */
    --radius-sm: 8px;
    --radius-md: 16px;
    --radius-lg: 24px;

    /* Font sizes - mobile readable at 1080 ref width */
    --font-xs: 24px;
    --font-sm: 28px;
    --font-md: 32px;
    --font-lg: 40px;
    --font-xl: 52px;
    --font-xxl: 64px;
}
