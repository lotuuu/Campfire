/* Codex panel styles */

#codex-panel .variant-entry {
    width: 200px;
    height: 180px;
    min-height: 180px;
    align-items: center;
    justify-content: center;
}

#codex-panel .variant-swatch {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-bottom: var(--spacing-sm);
}

#codex-panel .variant-name {
    color: var(--color-text);
    font-size: var(--font-xs);
    -unity-text-align: middle-center;
}

#detail-panel {
    margin-top: var(--spacing-md);
    padding: var(--spacing-md);
    background-color: rgba(30, 45, 30, 0.8);
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: var(--color-border);
}

#detail-name {
    font-size: var(--font-lg);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

#detail-description {
    font-size: var(--font-sm);
    color: var(--color-text);
    margin-top: var(--spacing-sm);
    white-space: normal;
}

#detail-rarity {
    font-size: var(--font-sm);
    color: var(--color-text-accent);
    margin-top: var(--spacing-sm);
}

#detail-color-swatch {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-top: var(--spacing-sm);
    border-width: 2px;
    border-color: var(--color-border);
}
