/* Codex panel styles */

/* --- Variant Entry Card --- */
#codex-page .variant-entry {
    width: 280px;
    height: 350px;
    min-height: 350px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 20px;
    padding-bottom: 0;
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    overflow: hidden;
}

.entry-sprite-frame {
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-sm);
}

.entry-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    opacity: 0;
    /* background-color and opacity set inline from C# */
}

.entry-sprite {
    width: 160px;
    height: 160px;
    -unity-background-scale-mode: scale-to-fit;
}

.entry-lock {
    position: absolute;
    font-size: 64px;
    color: var(--color-dim);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    opacity: 0.5;
}

#codex-page .variant-name {
    color: var(--color-text-bright);
    font-size: var(--font-sm);
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    padding: 0 var(--spacing-xxs);
}

.entry-rarity-bar {
    align-self: stretch;
    height: 3px;
    border-radius: 2px;
    /* background-color set inline from C# */
}

/* Undiscovered card dimming */
.variant-entry-undiscovered {
    opacity: 0.65;
}

/* Selected card highlight */
.variant-entry-selected {
    border-color: var(--color-border-accent);
    background-color: var(--color-bg-slot-hover);
}

/* --- Detail Panel --- */
#detail-panel {
    flex-direction: row;
    margin-top: var(--spacing-sm);
    padding: var(--spacing-md);
    background-color: rgba(15, 30, 40, 0.55);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
    align-items: center;
}

#detail-sprite-area {
    width: 140px;
    height: 140px;
    align-items: center;
    justify-content: center;
    margin-right: var(--spacing-md);
    flex-shrink: 0;
}

#detail-sprite-glow {
    position: absolute;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    opacity: 0;
    /* background-color set inline */
}

#detail-sprite {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

#detail-info {
    flex-grow: 1;
    flex-shrink: 1;
}

#detail-name {
    font-size: var(--font-lg);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--spacing-xxs);
}

#detail-rarity-badge {
    border-radius: 14px;
    padding: 4px 16px;
    margin-bottom: var(--spacing-sm);
    border-width: 1px;
    align-self: flex-start;
}

#detail-rarity {
    font-size: 18px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#detail-description {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    white-space: normal;
}

#detail-seed-name {
    font-size: var(--font-xs);
    color: var(--color-dim);
    margin-top: var(--spacing-xs);
}

/* --- Rarity Colors for Grid Names --- */
#codex-page .variant-name.rarity-common    { color: var(--color-rarity-common); }
#codex-page .variant-name.rarity-uncommon  { color: var(--color-rarity-uncommon); }
#codex-page .variant-name.rarity-rare      { color: var(--color-rarity-rare); }
#codex-page .variant-name.rarity-epic      { color: var(--color-rarity-epic); }
#codex-page .variant-name.rarity-legendary { color: var(--color-rarity-legendary); }

/* --- Detail Rarity Badge Colors --- */
#detail-rarity.rarity-common    { color: var(--color-rarity-common); }
#detail-rarity.rarity-uncommon  { color: var(--color-rarity-uncommon); }
#detail-rarity.rarity-rare      { color: var(--color-rarity-rare); }
#detail-rarity.rarity-epic      { color: var(--color-rarity-epic); }
#detail-rarity.rarity-legendary { color: var(--color-rarity-legendary); }
