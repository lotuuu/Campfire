/* Codex panel styles - mobile-first sizing */

#codex-page .variant-entry {
    width: 300px;
    height: 300px;
    min-height: 300px;
    align-items: center;
    justify-content: center;
}

#codex-page .variant-swatch {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    margin-bottom: var(--spacing-sm);
}

#codex-page .variant-name {
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
}

#detail-panel {
    margin-top: var(--spacing-md);
    padding: var(--spacing-lg);
    background-color: rgba(15, 30, 40, 0.50);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
}

#detail-name {
    font-size: var(--font-xl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

#detail-description {
    font-size: var(--font-md);
    color: var(--color-text);
    margin-top: var(--spacing-sm);
    white-space: normal;
}

#detail-rarity {
    font-size: var(--font-md);
    color: var(--color-text-accent);
    margin-top: var(--spacing-sm);
}

#detail-color-swatch {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-top: var(--spacing-sm);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.25);
}
