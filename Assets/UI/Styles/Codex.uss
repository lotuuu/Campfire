/* Codex panel styles - mobile-first sizing */

#variant-grid .unity-scroller--vertical,
#variant-grid .unity-scroller--horizontal {
    display: none;
}

#codex-page .variant-entry {
    width: 300px;
    height: 300px;
    min-height: 300px;
    align-items: center;
    justify-content: center;
}

#codex-page .variant-swatch {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    margin-bottom: var(--spacing-sm);
}

#codex-page .variant-name {
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
}

#detail-panel {
    flex-direction: row;
    margin-top: var(--spacing-md);
    padding: var(--spacing-lg);
    background-color: rgba(15, 30, 40, 0.50);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.20);
    border-top-color: rgba(140, 230, 240, 0.30);
}

#detail-info {
    flex-grow: 1;
    flex-shrink: 1;
}

#detail-seed {
    align-items: center;
    justify-content: center;
    margin-left: var(--spacing-lg);
    min-width: 160px;
}

#detail-seed-icon {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: var(--color-bg-slot);
    -unity-background-scale-mode: scale-to-fit;
}

#detail-seed-name {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    margin-top: var(--spacing-xs);
    white-space: normal;
    -unity-text-align: upper-center;
}

#detail-name {
    font-size: var(--font-xl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

#detail-description {
    font-size: var(--font-md);
    color: var(--color-text);
    margin-top: var(--spacing-sm);
    white-space: normal;
}

#detail-rarity {
    font-size: var(--font-md);
    margin-top: var(--spacing-sm);
}

/* Rarity color overrides for grid entry names (beat #codex-page .variant-name specificity) */
#codex-page .variant-name.rarity-common    { color: var(--color-rarity-common); }
#codex-page .variant-name.rarity-uncommon  { color: var(--color-rarity-uncommon); }
#codex-page .variant-name.rarity-rare      { color: var(--color-rarity-rare); }
#codex-page .variant-name.rarity-epic      { color: var(--color-rarity-epic); }
#codex-page .variant-name.rarity-legendary { color: var(--color-rarity-legendary); }

#detail-color-swatch {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-top: var(--spacing-sm);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.25);
}
