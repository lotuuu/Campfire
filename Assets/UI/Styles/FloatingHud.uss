/* FloatingHud.uss — Floating HUD elements + bloom card animations */

/* ── Floating HUD container ── */
#floating-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--spacing-sm);
    flex-direction: column;
    padding: 0 var(--spacing-sm);
    display: none;
}

/* ── Top row: profile | weather bar | menu ── */
#hud-top-row {
    flex-direction: row;
    align-items: flex-start;
}

/* ── Shared circle style ── */
.hud-circle {
    width: 192px;
    height: 192px;
    border-radius: 96px;
    background-color: rgba(20, 40, 20, 0.65);
    border-width: 2px;
    border-color: rgba(214, 154, 53, 0.3);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* Profile circle — larger, primary action */
.hud-left {
    width: 256px;
    height: 256px;
    border-radius: 128px;
    border-width: 3px;
    border-color: rgba(214, 154, 53, 0.5);
}

#hud-profile-pic {
    width: 240px;
    height: 240px;
    border-radius: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

#hud-visiting-name {
    display: none;
    position: absolute;
    top: 260px;
    left: 0;
    background-color: rgba(20, 40, 20, 0.75);
    border-radius: var(--radius-sm);
    padding: var(--spacing-xxs) var(--spacing-xs);
    white-space: nowrap;
}

#hud-visiting-name Label {
    font-size: var(--font-sm);
    color: var(--color-text-bright);
}

/* ── Weather bar (center pill) ── */
#hud-weather-bar-wrapper {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: flex-start;
}

.hud-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 40, 20, 0.65);
    border-radius: 28px;
    border-width: 2px;
    border-color: rgba(214, 154, 53, 0.3);
    padding: var(--spacing-xs) var(--spacing-md);
    flex-shrink: 0;
}

#hud-weather-temp,
#hud-weather-humidity,
#hud-weather-status {
    font-size: var(--font-sm);
    -unity-font-style: bold;
    color: var(--color-text-bright);
}

.hud-weather-divider {
    width: 1px;
    height: 24px;
    background-color: rgba(255, 255, 255, 0.15);
    margin: 0 var(--spacing-xs);
}

/* ── Menu circle (right) ── */
.hud-right {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    margin-left: auto;
    margin-top: var(--spacing-md);
    margin-right: var(--spacing-sm);
}

#hud-menu-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Resource panel (sits just below profile circle) ── */
#hud-resources {
    position: absolute;
    top: 128px;
    left: var(--spacing-sm);
    flex-direction: column;
    background-color: rgba(20, 40, 20, 0.82);
    border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    border-width: 2px;
    border-color: rgba(214, 154, 53, 0.3);
    padding: 136px var(--spacing-sm) var(--spacing-xs) var(--spacing-sm);
}

.hud-res-pill {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
}

.hud-res-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-xxs);
}

.hud-res-pill Label {
    font-size: var(--font-md);
    -unity-font-style: bold;
}

#hud-mana {
    color: var(--color-mana);
}

#hud-water {
    color: var(--color-water);
}

#hud-mallum {
    color: var(--color-text);
}

/* ══════════════════════════════════════════════
   BLOOM CARD — ANIMATION SYSTEM
   ══════════════════════════════════════════════ */

.bloom-card {
    position: absolute;
    width: 192px;
    height: 192px;
    border-radius: 96px;
    background-color: rgba(20, 40, 20, 0.92);
    border-width: 2px;
    border-color: rgba(214, 154, 53, 0.3);
    overflow: hidden;
    opacity: 0;
    scale: 0.8 0.8;
    /* layering via UXML element order */

    transition-property: width, height, border-radius, opacity, scale;
    transition-duration: 400ms, 400ms, 400ms, 200ms, 400ms;
    transition-timing-function: ease-out-back, ease-out-back, ease, ease, ease-out-back;
}

.bloom-card.bloom-open {
    opacity: 1;
    scale: 1 1;
}

/* ── Bloom content (delayed fade-in) ── */
.bloom-content {
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 300ms, 300ms;
    transition-delay: 150ms, 150ms;
    transition-timing-function: ease, ease;
    padding: var(--spacing-md);
    flex-grow: 1;
}

.bloom-card.bloom-open .bloom-content {
    opacity: 1;
    translate: 0 0;
}

/* ── Forecast bloom: anchored center-top (expands from weather bar) ── */
.bloom-center {
    top: 10px;
    left: 5%;
    right: 5%;
    width: 90%;
    height: 56px;
    border-radius: 28px;
}

.bloom-center.bloom-open {
    height: 80%;
    border-radius: var(--radius-lg);
}

/* ── Settings bloom: anchored top-right ── */
.bloom-right {
    top: 10px;
    right: 12px;
}

.bloom-right.bloom-open {
    width: 90%;
    height: 70%;
    border-radius: var(--radius-lg);
}

/* ── Profile bloom: anchored top-left ── */
.bloom-left {
    top: 10px;
    left: 12px;
}

.bloom-left.bloom-open {
    width: 90%;
    height: 85%;
    border-radius: var(--radius-lg);
}

/* ══════════════════════════════════════════════
   FORECAST CARD — WEATHER POPUP CONTENT
   ══════════════════════════════════════════════ */

.forecast-bloom-title {
    color: rgb(214, 154, 53);
    font-size: var(--font-xl);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom-width: 2px;
    border-bottom-color: rgba(214, 154, 53, 0.2);
}

/* ── Stats grid rows (used in today card and day cards) ── */
.forecast-stats-row {
    flex-direction: row;
    justify-content: space-between;
    padding: var(--spacing-xs) 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.forecast-stat-cell {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding: var(--spacing-xxs);
}

.forecast-stat-value {
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.forecast-stat-label {
    color: var(--color-text-dim);
    font-size: var(--font-xs);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.forecast-stat-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 2px;
}

.forecast-section-label {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
}

/* ── Day forecast cards ── */
.forecast-day {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

.forecast-day-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-xs);
    padding-bottom: var(--spacing-xs);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.forecast-day-name {
    font-size: var(--font-sm);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    margin-right: var(--spacing-xs);
}

.forecast-day-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-xxs);
}

.forecast-day-condition {
    font-size: var(--font-sm);
    color: var(--color-text);
    flex-grow: 1;
}

.forecast-day-moon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    margin-left: auto;
}

/* ── Outlier color classes ── */
.stat-hot { color: rgb(255, 110, 60); }
.stat-cold { color: rgb(100, 175, 235); }
.stat-dry { color: rgb(230, 145, 55); }
.stat-humid { color: rgb(100, 175, 235); }
.stat-windy { color: rgb(200, 210, 220); }

/* ══════════════════════════════════════════════
   PROFILE POPUP — SETTINGS & PLAYER INFO
   ══════════════════════════════════════════════ */

/* ── Section headers ── */
.profile-section-header {
    font-size: var(--font-sm);
    color: rgb(214, 154, 53);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-xs);
    border-bottom-width: 2px;
    border-bottom-color: rgba(214, 154, 53, 0.2);
}

/* ── Player identity ── */
#profile-identity {
    align-items: center;
    padding: var(--spacing-sm) 0;
    margin-bottom: var(--spacing-md);
}

/* Profile pic with edit overlay */
#profile-pic-wrapper {
    width: 160px;
    height: 160px;
    margin-bottom: var(--spacing-md);
}

#profile-pic-large {
    width: 160px;
    height: 160px;
    border-radius: 80px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(60, 95, 45);
    border-width: 3px;
    border-color: rgb(214, 154, 53);
}

.profile-pic-edit {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(214, 154, 53, 0.9);
    border-width: 2px;
    border-color: rgb(180, 120, 40);
    align-items: center;
    justify-content: center;
    font-size: var(--font-sm);
    color: rgb(40, 25, 10);
    -unity-text-align: middle-center;
}

.profile-pic-edit:hover {
    background-color: rgb(230, 170, 60);
}

/* Name row: label + edit button */
#profile-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-xs);
}

#profile-display-name-label {
    font-size: var(--font-lg);
    color: var(--color-text-bright);
    -unity-font-style: bold;
}

.profile-name-edit {
    width: 48px;
    height: 48px;
    margin-left: var(--spacing-xs);
    background-color: transparent;
    border-width: 0;
    font-size: var(--font-sm);
    color: var(--color-text-dim);
}

.profile-name-edit:hover {
    color: var(--color-text-bright);
}

#profile-display-name {
    font-size: var(--font-md);
    min-height: 80px;
    margin-bottom: var(--spacing-xs);
}

#profile-friend-code {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    margin-top: var(--spacing-sm);
}

/* ── Profile pic selector popup ── */
#profile-pic-selector {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(20, 40, 20, 1.0);
    padding: var(--spacing-md);
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
}

#profile-pic-selector .profile-section-header {
    margin-top: 0;
    -unity-text-align: upper-center;
}

#profile-pic-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin: var(--spacing-md) 0;
}

.pfp-option {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(40, 60, 35);
    border-width: 2px;
    border-color: rgba(140, 100, 50, 0.3);
    margin: var(--spacing-xs);
    transition-property: border-color, scale;
    transition-duration: 150ms;
}

.pfp-option:hover {
    border-color: rgba(214, 154, 53, 0.6);
    scale: 1.05 1.05;
}

.pfp-option.pfp-selected {
    border-width: 3px;
    border-color: rgb(214, 154, 53);
}

.profile-pic-done-btn {
    min-height: 80px;
    min-width: 200px;
    background-color: var(--color-button-bg);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-bright);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
}

/* ── Camp stats ── */
#profile-stats {
    padding: var(--spacing-sm) 0;
}

#profile-stats Label {
    font-size: var(--font-md);
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
}

#profile-flame-level {
    font-size: var(--font-lg);
    color: var(--color-text-accent);
    -unity-font-style: bold;
}

/* ── Toggle rows (vibration) ── */
.profile-toggle-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
    min-height: 96px;
    padding: var(--spacing-xs) 0;
}

.profile-toggle-row Label {
    color: var(--color-text);
    font-size: var(--font-md);
}

#profile-bloom .unity-toggle .unity-toggle__checkmark {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
}

/* ── Slider rows (music, sfx) ── */
.profile-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-md);
    min-height: 96px;
    padding: var(--spacing-xs) 0;
}

.profile-slider-row Label {
    color: var(--color-text);
    font-size: var(--font-md);
    min-width: 140px;
}

.profile-slider-row .unity-base-slider {
    flex-grow: 1;
    margin: 0 var(--spacing-sm);
    min-height: 80px;
}

.profile-slider-row .unity-base-slider .unity-base-slider__dragger {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(255, 170, 60);
}

.profile-slider-row .unity-base-slider .unity-base-slider__tracker {
    height: 12px;
    background-color: rgba(180, 120, 60, 0.3);
    border-radius: 6px;
}

/* ── Language dropdown ── */
#profile-bloom .unity-popup-field {
    min-height: 80px;
    font-size: var(--font-md);
    margin-bottom: var(--spacing-md);
}

/* ── Account info ── */
#profile-account {
    padding: var(--spacing-xs) 0;
}

#profile-account Label {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-xs);
    padding: var(--spacing-xxs) 0;
}

/* ── Danger zone ── */
#profile-delete-btn {
    min-height: 96px;
    background-color: rgba(140, 40, 30, 0.7);
    border-width: 2px;
    border-color: rgba(200, 80, 60, 0.4);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 200);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
    margin-top: var(--spacing-md);
}

#profile-delete-btn:hover {
    background-color: rgba(160, 50, 35, 0.85);
}

#profile-confirm-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--spacing-sm);
}

#profile-confirm-row Label {
    flex-grow: 1;
    color: rgb(220, 90, 70);
    font-size: var(--font-md);
    -unity-font-style: bold;
}

#profile-confirm-cancel {
    min-height: 80px;
    min-width: 180px;
    background-color: rgba(60, 40, 20, 0.6);
    border-width: 2px;
    border-color: rgba(140, 100, 50, 0.3);
    border-radius: var(--radius-sm);
    color: rgb(220, 200, 160);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
    margin-right: var(--spacing-sm);
}

#profile-confirm-cancel:hover {
    background-color: rgba(80, 50, 25, 0.7);
}

#profile-confirm-delete {
    min-height: 80px;
    min-width: 180px;
    background-color: rgba(180, 40, 30, 0.8);
    border-width: 2px;
    border-color: rgba(220, 80, 60, 0.5);
    border-radius: var(--radius-sm);
    color: rgb(255, 220, 200);
    font-size: var(--font-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#profile-confirm-delete:hover {
    background-color: rgba(200, 50, 35, 0.9);
}

#profile-debug-btn {
    min-height: 80px;
    margin-top: var(--spacing-md);
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

/* ══════════════════════════════════════════════
   BLOOM DISMISS BACKDROP
   ══════════════════════════════════════════════ */

#bloom-dismiss {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* layering via UXML element order */
}

#bloom-dismiss.bloom-dismiss-active {
    display: flex;
}
