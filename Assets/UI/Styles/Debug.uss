/* Debug panel styles */

#debug-panel {
    padding: var(--spacing-md);
    padding-top: var(--spacing-xl);
}

#debug-panel .debug-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-sm);
    min-height: 72px;
}

#debug-panel .debug-label {
    width: 160px;
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

#debug-panel .debug-value {
    width: 130px;
    color: var(--color-text);
    font-size: var(--font-sm);
    -unity-text-align: middle-right;
    margin-left: var(--spacing-sm);
}

#debug-panel .unity-base-slider {
    flex-grow: 1;
    min-height: 60px;
}

#debug-panel .unity-base-slider .unity-base-slider__dragger {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: var(--color-text-accent);
}

#debug-panel .unity-base-slider .unity-base-slider__tracker {
    height: 8px;
    background-color: var(--color-border);
    border-radius: 4px;
}

#debug-panel .unity-base-field__label {
    min-width: 160px;
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

#debug-panel .unity-popup-field {
    margin-bottom: var(--spacing-sm);
    min-height: 72px;
}

#debug-panel .unity-popup-field .unity-base-field__label {
    min-width: 160px;
    font-size: var(--font-sm);
}

#debug-panel .unity-popup-field .unity-base-popup-field__text {
    font-size: var(--font-sm);
}

#debug-panel .unity-toggle {
    min-height: 72px;
    margin-bottom: var(--spacing-sm);
}

#debug-panel .unity-toggle .unity-base-field__label {
    color: var(--color-text);
    font-size: var(--font-md);
}

#debug-panel .unity-toggle .unity-toggle__checkmark {
    width: 48px;
    height: 48px;
}

#preset-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

.preset-btn {
    margin: var(--spacing-xs);
    font-size: var(--font-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    min-height: 80px;
}
