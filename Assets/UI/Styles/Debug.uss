/* Debug.uss — Debug panel styling */

#debug-panel {
    display: none;
    flex-grow: 1;
}

#debug-panel .debug-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--spacing-md);
    min-height: 96px;
}

#debug-panel .debug-label {
    width: 180px;
    color: rgb(160, 140, 110);
    font-size: var(--font-md);
}

#debug-panel .debug-value {
    width: 150px;
    color: rgb(230, 210, 180);
    font-size: var(--font-md);
    -unity-text-align: middle-right;
    margin-left: var(--spacing-sm);
}

/* Sliders */
#debug-panel .unity-base-slider {
    flex-grow: 1;
    min-height: 80px;
}

#debug-panel .unity-base-slider .unity-base-slider__dragger {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(255, 170, 60);
}

#debug-panel .unity-base-slider .unity-base-slider__tracker {
    height: 12px;
    background-color: rgba(180, 120, 60, 0.3);
    border-radius: 6px;
}

/* Shared field label */
#debug-panel .unity-base-field__label {
    min-width: 180px;
    color: rgb(160, 140, 110);
    font-size: var(--font-md);
}

/* Dropdowns */
#debug-panel .unity-popup-field {
    margin-bottom: var(--spacing-md);
    min-height: 96px;
}

#debug-panel .unity-popup-field .unity-base-field__label {
    min-width: 180px;
    font-size: var(--font-md);
}

#debug-panel .unity-popup-field .unity-base-popup-field__text {
    font-size: var(--font-md);
}

#debug-panel .unity-popup-field .unity-base-popup-field__input {
    min-height: 72px;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
}

/* Preset buttons */
#preset-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

.preset-btn {
    margin: var(--spacing-xs);
    font-size: var(--font-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    min-height: 88px;
}

/* Text and integer fields */
#debug-panel .unity-text-field,
#debug-panel .unity-integer-field {
    flex-grow: 1;
    min-height: 80px;
    margin-bottom: 0;
}

#debug-panel .unity-text-field .unity-text-input,
#debug-panel .unity-integer-field .unity-text-input {
    font-size: var(--font-md);
    min-height: 72px;
    padding: var(--spacing-xs) var(--spacing-sm);
    color: rgb(230, 210, 180);
    background-color: rgba(40, 25, 15, 0.6);
    border-width: 1px;
    border-color: rgba(180, 120, 60, 0.2);
    border-radius: var(--radius-sm);
}

#debug-panel .unity-text-field .unity-base-field__label,
#debug-panel .unity-integer-field .unity-base-field__label {
    display: none;
}

/* Current time label */
#current-time-label {
    font-size: var(--font-sm);
    color: rgb(160, 140, 110);
    margin-top: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
}

/* Section headers */
.debug-section-header {
    font-size: var(--font-lg);
    color: rgb(230, 210, 180);
    -unity-font-style: bold;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom-width: 1px;
    border-bottom-color: rgba(180, 120, 60, 0.2);
}

/* Danger buttons */
.btn-danger {
    background-color: rgba(140, 40, 30, 0.7);
    border-color: rgba(200, 80, 60, 0.4);
    color: rgb(255, 220, 200);
}

.btn-danger:hover {
    background-color: rgba(160, 50, 35, 0.85);
}
