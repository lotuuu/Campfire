/* Common styles shared across all panels */

.panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--color-bg-panel);
    padding-top: var(--spacing-xl);
    padding-right: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    padding-left: var(--spacing-lg);
    border-width: 1px;
    border-color: var(--color-border);
    border-top-color: rgba(140, 230, 240, 0.25);
}

.panel-header {
    font-size: var(--font-xl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
}

.btn {
    background-color: var(--color-button-bg);
    color: var(--color-text);
    border-width: 1px;
    border-color: var(--color-border-accent);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: var(--font-md);
    min-height: 88px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.btn:hover {
    background-color: var(--color-button-bg-hover);
    border-color: rgba(140, 230, 240, 0.5);
}

.btn:active {
    background-color: var(--color-button-bg-active);
}

.btn:disabled {
    background-color: var(--color-button-bg-disabled);
    color: var(--color-text-dim);
    border-color: var(--color-border);
}

.btn-loading {
    background-color: var(--color-button-bg-disabled);
    color: var(--color-text-dim);
    border-color: var(--color-border);
}

.btn-close {
    position: absolute;
    right: var(--spacing-md);
    top: var(--spacing-md);
    width: 88px;
    height: 88px;
    font-size: var(--font-lg);
    padding: 0;
    border-radius: 44px;
}

.label {
    color: var(--color-text);
    font-size: var(--font-md);
}

.label-dim {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

.label-accent {
    color: var(--color-text-accent);
    font-size: var(--font-md);
}

.label-coming-soon {
    font-size: var(--font-lg);
}

.scroll-view {
    flex-grow: 1;
}

.scroll-view .unity-scroller--vertical,
.scroll-view .unity-scroller--horizontal {
    display: none;
}

.scroll-view .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: var(--spacing-sm);
}

.grid-item {
    background-color: var(--color-bg-slot);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.grid-item:hover {
    background-color: var(--color-bg-slot-hover);
    border-color: var(--color-border-accent);
}

/* Rarity colors */
.rarity-common    { color: var(--color-rarity-common); }
.rarity-uncommon  { color: var(--color-rarity-uncommon); }
.rarity-rare      { color: var(--color-rarity-rare); }
.rarity-epic      { color: var(--color-rarity-epic); }
.rarity-legendary { color: var(--color-rarity-legendary); }

.separator {
    height: 2px;
    background-color: var(--color-border);
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

/* Location gate overlay */
.gate-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--color-bg-gate);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: var(--spacing-lg);
}

.gate-title {
    font-size: var(--font-xxl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
}

.gate-subtitle {
    font-size: var(--font-sm);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-lg);
    -unity-text-align: middle-center;
}

/* Page content (inside SwipeablePageView) */
.page-content {
    flex-grow: 1;
    padding-top: var(--spacing-md);
    padding-right: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    padding-left: var(--spacing-lg);
}

/* Overlay panel (debug etc) - stays absolute */
.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--color-bg-panel);
}

/* Bottom sheet overlay */
.scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.bottom-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 70%;
    background-color: var(--color-bg-sheet);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    border-top-width: 1px;
    border-top-color: rgba(140, 230, 240, 0.25);
    padding: var(--spacing-md) var(--spacing-lg);
    transition-property: translate;
    transition-duration: 250ms;
    transition-timing-function: ease-out;
}

/* Full-width 44px touch target — pointer events registered on this */
.bottom-sheet-drag-zone {
    width: 100%;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* Visual pill inside the drag zone */
.bottom-sheet-handle-pip {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(120, 150, 170, 0.4);
}

/* ── Dropdown popup (renders at panel root, outside any scoped selector) ── */
.unity-base-dropdown {
    background-color: transparent;
}

.unity-base-dropdown__container-outer {
    background-color: var(--color-bg-popup);
    border-width: 1px;
    border-color: rgba(140, 230, 240, 0.25);
    border-radius: var(--radius-sm);
}

.unity-base-dropdown__container-inner {
    background-color: transparent;
}

.unity-base-dropdown__item {
    min-height: 96px;
    padding-left: var(--spacing-md);
    padding-right: var(--spacing-md);
    font-size: var(--font-md);
    color: var(--color-text);
    border-radius: 0;
    background-color: transparent;
}

.unity-base-dropdown__item > Label,
.unity-base-dropdown__item .unity-base-dropdown__item-label,
.unity-base-dropdown__item #unity-text-element {
    font-size: var(--font-md);
    color: rgb(200, 220, 230);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* Catch-all: target every element inside the popup */
.unity-base-dropdown * {
    font-size: var(--font-md);
}

.unity-base-dropdown__item:hover {
    background-color: rgba(100, 220, 220, 0.12);
    color: var(--color-text-bright);
}

.unity-base-dropdown__item--is-checked {
    color: var(--color-text-accent);
}

.unity-base-dropdown__checkmark {
    width: 36px;
    height: 36px;
    margin-right: var(--spacing-sm);
    -unity-background-image-tint-color: var(--color-text-accent);
}

.unity-base-dropdown__separator {
    height: 1px;
    background-color: rgba(120, 200, 220, 0.15);
    margin: var(--spacing-xs) 0;
}
