/* Common styles shared across all panels */

.panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--color-bg-panel);
    padding: var(--spacing-lg);
    padding-top: var(--spacing-xl);
}

.panel-header {
    font-size: var(--font-xl);
    color: var(--color-text-bright);
    -unity-font-style: bold;
    margin-bottom: var(--spacing-md);
}

.btn {
    background-color: var(--color-button-bg);
    color: var(--color-text);
    border-width: 2px;
    border-color: var(--color-border-accent);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: var(--font-md);
    min-height: 88px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.btn:hover {
    background-color: var(--color-button-bg-hover);
}

.btn:active {
    background-color: var(--color-button-bg-active);
}

.btn:disabled {
    background-color: var(--color-button-bg-disabled);
    color: var(--color-text-dim);
    border-color: var(--color-border);
}

.btn-close {
    position: absolute;
    right: var(--spacing-md);
    top: var(--spacing-md);
    width: 80px;
    height: 80px;
    font-size: var(--font-lg);
    min-height: 80px;
    padding: 0;
    border-radius: 40px;
}

.label {
    color: var(--color-text);
    font-size: var(--font-md);
}

.label-dim {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
}

.label-accent {
    color: var(--color-text-accent);
    font-size: var(--font-md);
}

.scroll-view {
    flex-grow: 1;
}

.scroll-view .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: var(--spacing-sm);
}

.grid-item {
    background-color: var(--color-bg-slot);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin: var(--spacing-xs);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.grid-item:hover {
    background-color: var(--color-bg-slot-hover);
}

.separator {
    height: 2px;
    background-color: var(--color-border);
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}
