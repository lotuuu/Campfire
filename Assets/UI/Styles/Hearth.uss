/* Hearth: Isometric farm plot on the home screen */

#hearth-view {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

#hearth-title {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
    margin-bottom: var(--spacing-md);
    -unity-text-align: middle-center;
}

#hearth-plot {
    width: 380px;
    height: 380px;
    rotate: 45deg;
    background-color: rgba(20, 50, 40, 0.30);
    border-width: 2px;
    border-color: rgba(80, 160, 120, 0.20);
    border-radius: var(--radius-md);
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    align-content: center;
}

.hearth-slot {
    width: 180px;
    height: 180px;
    margin: 4px;
    background-color: rgba(20, 35, 50, 0.40);
    border-width: 1px;
    border-color: rgba(120, 200, 220, 0.15);
    border-radius: var(--radius-sm);
    padding: 0;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s;
}

.hearth-slot:hover {
    background-color: rgba(30, 50, 65, 0.55);
    border-color: rgba(140, 230, 240, 0.35);
    scale: 1.03;
}

.hearth-slot:active {
    background-color: rgba(40, 70, 85, 0.75);
}

.hearth-slot-mature {
    border-color: var(--color-highlight);
    border-width: 2px;
}

.hearth-slot-inner {
    rotate: -45deg;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.hearth-soil {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgba(90, 65, 40, 0.50);
    border-width: 1px;
    border-color: rgba(130, 100, 60, 0.30);
    margin-bottom: var(--spacing-xs);
}

.hearth-plant-swatch {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    margin-bottom: var(--spacing-xs);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.hearth-slot-label {
    color: var(--color-text-dim);
    font-size: var(--font-xs);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.hearth-progress-bar {
    width: 120px;
    height: 8px;
    background-color: rgba(20, 35, 50, 0.50);
    border-radius: 4px;
    overflow: hidden;
}

.hearth-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--color-text-accent);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.3s;
}
