/* WeatherBar.uss — 4-cell weather bar */

#weather-bar {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: var(--spacing-xs);
}

.weather-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-sm) var(--spacing-xs);
    background-color: var(--color-bg-slot);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-sm);
    margin-right: var(--spacing-xs);
}

.weather-cell-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: var(--spacing-xs);
}

#weather-condition-label {
    font-size: var(--font-sm);
    color: rgb(50, 35, 15);
    -unity-font-style: bold;
    margin-right: var(--spacing-xxs);
}

#weather-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

#weather-humidity {
    font-size: var(--font-sm);
    color: rgb(50, 35, 15);
    -unity-font-style: bold;
}

#weather-temp {
    font-size: var(--font-sm);
    color: rgb(50, 35, 15);
    -unity-font-style: bold;
}

#weather-cell-moon {
    justify-content: center;
    align-items: center;
}

#weather-moon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}
