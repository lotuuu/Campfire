<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Button class="grid-item variant-entry">
        <ui:VisualElement class="entry-sprite-frame">
            <ui:VisualElement class="entry-glow" />
            <ui:VisualElement class="entry-sprite" />
            <ui:Label class="entry-lock" text="?" />
        </ui:VisualElement>
        <ui:Label class="variant-name" />
        <ui:VisualElement class="entry-rarity-bar" />
    </ui:Button>
</ui:UXML>
