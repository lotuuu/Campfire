<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="grid-item plant-slot">
        <ui:VisualElement class="plant-sprite-frame">
            <ui:VisualElement class="plant-glow" />
            <ui:VisualElement class="plant-sprite" />
        </ui:VisualElement>
        <ui:Label class="plant-name" />
        <ui:Label class="plant-quality" />
        <ui:VisualElement class="plant-decay-bar-bg">
            <ui:VisualElement class="plant-decay-bar-fill" />
        </ui:VisualElement>
        <ui:Label class="plant-decay-time" />
        <ui:VisualElement class="plant-rarity-bar" />
    </ui:VisualElement>
</ui:UXML>
