<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="discovery-overlay" class="discovery-overlay" picking-mode="Position">
        <ui:VisualElement name="discovery-card" class="discovery-card">
            <!-- Ambient radiance behind card content -->
            <ui:VisualElement name="card-radiance" class="card-radiance" />

            <!-- Header banner -->
            <ui:VisualElement class="discovery-header">
                <ui:VisualElement class="header-rule" />
                <ui:Label class="header-label" text="NEW DISCOVERY" />
                <ui:VisualElement class="header-rule" />
            </ui:VisualElement>

            <!-- Sprite showcase with layered glow -->
            <ui:VisualElement name="sprite-stage" class="sprite-stage">
                <ui:VisualElement name="sprite-glow" class="sprite-glow" />
                <ui:VisualElement name="sprite-ring" class="sprite-ring" />
                <ui:VisualElement name="sprite-container" class="discovery-sprite" />
            </ui:VisualElement>

            <!-- Variant info -->
            <ui:Label name="variant-name" class="discovery-name" text="" />
            <ui:VisualElement name="rarity-badge" class="rarity-badge">
                <ui:Label name="rarity-label" class="rarity-badge-text" text="" />
            </ui:VisualElement>

            <!-- Ornamental divider -->
            <ui:VisualElement class="ornament-divider">
                <ui:VisualElement class="ornament-line" />
                <ui:VisualElement class="ornament-diamond" />
                <ui:VisualElement class="ornament-line" />
            </ui:VisualElement>

            <!-- Description -->
            <ui:Label name="variant-description" class="discovery-description" text="" />

            <!-- Actions -->
            <ui:VisualElement class="discovery-actions">
                <ui:Button name="share-button" text="Share Discovery" class="discovery-share-btn" />
                <ui:Label class="discovery-dismiss-hint" text="Tap anywhere to continue" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
